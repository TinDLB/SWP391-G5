@model SWP391_G5.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên Mật Khẩu - Tiệm Bánh BMS";
}

<div class="auth-wrapper">
    <div class="auth-card" style="max-width: 500px; margin: 0 auto;">
        <div class="auth-form-side p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 70px; height: 70px; background-color: var(--bakery-cream); color: var(--bakery-primary); border: 2px solid var(--bakery-secondary);">
                    <i class="bi bi-key-fill fs-1"></i>
                </div>
                <h2 class="fw-bold" style="color: var(--bakery-dark);">Quên Mật Khẩu</h2>
                <p class="text-muted small">
                    Nhập địa chỉ Email đăng ký tài khoản của bạn. Chúng tôi sẽ gửi mã OTP gồm 6 chữ số để bạn đặt lại mật khẩu.
                </p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div class="form-floating mb-4">
                    <input asp-for="Email" type="email" class="form-control" placeholder=" " autofocus />
                    <label asp-for="Email"><i class="bi bi-envelope me-1"></i> Địa chỉ Email</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-bakery w-100 py-3 mb-3">
                    <i class="bi bi-send-fill me-1"></i> Gửi Mã OTP Xác Thực
                </button>

                <div class="text-center mt-3 pt-3 border-top">
                    <a asp-action="Login" asp-controller="Account" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng Nhập
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
