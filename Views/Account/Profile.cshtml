@model SWP391_G5.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Quản Lý Tài Khoản - Tiệm Bánh BMS";
    var activeTab = Model.ActiveTab ?? "info";
}

<div class="container py-5" style="max-width: 1040px;">
    <!-- Tiêu đề trang -->
    <div class="mb-4 pb-3 border-bottom">
        <h2 class="fw-bold mb-0" style="color: var(--bakery-dark);">
            <i class="bi bi-person-circle me-2" style="color: var(--bakery-primary);"></i>Quản Lý Tài Khoản
        </h2>
    </div>

    <!-- Thông báo kết quả thực hiện -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm border-0" role="alert" style="border-left: 5px solid #198754 !important;">
            <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5 text-success"></i>
            <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm border-0" role="alert" style="border-left: 5px solid #dc3545 !important;">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5 text-danger"></i>
            <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
            <div>
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Thông tin tổng quan & Menu Tabs -->
        <div class="col-lg-4 col-md-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white" style="border: 1px solid #f0e6d8 !important;">
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, var(--bakery-dark), var(--bakery-primary));">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow mb-3" style="width: 80px; height: 80px; font-size: 32px; font-weight: bold; color: var(--bakery-primary) !important;">
                        @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <h5 class="fw-bold mb-1 text-white">@Model.FullName</h5>
                    <div class="small opacity-75">@Model.Email</div>
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <div class="small opacity-75 mt-1"><i class="bi bi-telephone me-1"></i>@Model.PhoneNumber</div>
                    }
                    <div class="small opacity-90 mt-2 bg-white bg-opacity-25 rounded-pill px-3 py-1 d-inline-block">
                        <i class="bi bi-stars text-warning me-1"></i> Điểm tích lũy: <strong>@Model.LoyaltyPoints</strong> điểm
                    </div>
                </div>

                <div class="list-group list-group-flush p-2" id="sidebarMenu">
                    <button type="button" class="list-group-item list-group-item-action @(activeTab == "info" ? "active" : "") rounded-3 mb-1 border-0 fw-semibold text-start d-flex align-items-center justify-content-between" id="sidebar-info-btn" onclick="activateTab('info')">
                        <span><i class="bi bi-person-lines-fill me-2"></i> Thông tin cá nhân</span>
                        <i class="bi bi-chevron-right small opacity-50"></i>
                    </button>
                    <button type="button" class="list-group-item list-group-item-action @(activeTab == "address" ? "active" : "") rounded-3 mb-1 border-0 fw-semibold text-start d-flex align-items-center justify-content-between" id="sidebar-address-btn" onclick="activateTab('address')">
                        <span><i class="bi bi-geo-alt-fill me-2 text-primary"></i> Sổ địa chỉ nhận hàng</span>
                        <i class="bi bi-chevron-right small opacity-50"></i>
                    </button>
                    <button type="button" class="list-group-item list-group-item-action @(activeTab == "password" ? "active" : "") rounded-3 mb-1 border-0 fw-semibold text-start d-flex align-items-center justify-content-between" id="sidebar-password-btn" onclick="activateTab('password')">
                        <span><i class="bi bi-key-fill me-2 text-warning"></i> Quản lý mật khẩu</span>
                        <i class="bi bi-chevron-right small opacity-50"></i>
                    </button>
                    <a asp-action="Index" asp-controller="Order" class="list-group-item list-group-item-action rounded-3 mb-1 border-0 text-dark d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-clock-history me-2 text-success"></i> Đơn hàng của tôi</span>
                        <i class="bi bi-chevron-right small opacity-50"></i>
                    </a>
                    <a asp-action="Index" asp-controller="Notification" class="list-group-item list-group-item-action rounded-3 mb-1 border-0 text-dark d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-bell me-2 text-warning"></i> Thông báo</span>
                        <i class="bi bi-chevron-right small opacity-50"></i>
                    </a>
                    <form asp-action="Logout" asp-controller="Account" method="post" class="mt-2 pt-2 border-top">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="list-group-item list-group-item-action text-danger rounded-3 border-0 w-100 text-start">
                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột phải: Nội dung chi tiết các Tab -->
        <div class="col-lg-8 col-md-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white" style="border: 1px solid #f0e6d8 !important;">

                <!-- ================= PHẦN 1: THÔNG TIN CÁ NHÂN ================= -->
                <div id="tab-info" class="@(activeTab == "info" ? "" : "d-none")">
                    <div class="mb-4 pb-2 border-bottom">
                        <h4 class="fw-bold mb-1" style="color: var(--bakery-dark);">Cập Nhật Thông Tin Cá Nhân</h4>
                        <p class="text-muted small mb-0">Bạn có thể thay đổi số điện thoại và địa chỉ giao hàng bên dưới sau đó bấm "Lưu Thay Đổi".</p>
                    </div>

                    <form asp-action="Profile" asp-controller="Account" method="post" id="formProfile">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Role" />

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold text-muted small">Địa chỉ Email (Định danh tài khoản)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" class="form-control bg-light border-start-0" readonly tabindex="-1" />
                            </div>
                            <div class="form-text text-muted small">Email được dùng làm tên đăng nhập cố định và nhận thông báo đơn hàng.</div>
                        </div>

                        <!-- Họ và tên -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold small">Họ và tên <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên đầy đủ" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Số điện thoại -->
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold small">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0912345678" />
                            </div>
                            <div class="form-text text-muted small">Gồm 10 số (bắt đầu bằng 03, 05, 07, 08, 09) dùng để shipper liên hệ giao bánh.</div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- Địa chỉ nhận hàng nhanh -->
                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-bold small">Địa chỉ nhận hàng mặc định</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <textarea asp-for="Address" class="form-control" rows="2" placeholder="Nhập số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                            </div>
                            <div class="form-text text-muted small">Địa chỉ này sẽ được ưu tiên tự động điền khi bạn tiến hành thanh toán đơn hàng.</div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary px-4 py-2">
                                Quay lại Trang Chủ
                            </a>
                            <button type="submit" class="btn btn-bakery px-4 py-2 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>

                <!-- ================= PHẦN 2: SỔ ĐỊA CHỈ NHẬN HÀNG (UC-05) ================= -->
                <div id="tab-address" class="@(activeTab == "address" ? "" : "d-none")">
                    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                        <div>
                            <h4 class="fw-bold mb-1" style="color: var(--bakery-dark);">Sổ Địa Chỉ Giao Hàng</h4>
                            <p class="text-muted small mb-0">Quản lý các địa chỉ nhận hàng để đặt bánh nhanh chóng và tiện lợi.</p>
                        </div>
                        <button type="button" class="btn btn-sm btn-bakery rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                            <i class="bi bi-plus-circle me-1"></i> Thêm Địa Chỉ Mới
                        </button>
                    </div>

                    @if (Model.Addresses != null && Model.Addresses.Any())
                    {
                        <div class="row g-3">
                            @foreach (var addr in Model.Addresses)
                            {
                                <div class="col-12">
                                    <div class="card border rounded-3 p-3 position-relative @(addr.IsDefault ? "border-success bg-light bg-opacity-25" : "")">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <strong class="text-dark fs-6">@addr.ReceiverName</strong>
                                                <span class="text-muted ms-2 small"><i class="bi bi-telephone me-1"></i>@addr.Phone</span>
                                                @if (addr.IsDefault)
                                                {
                                                    <span class="badge bg-success ms-2 px-2 py-1"><i class="bi bi-check2-circle me-1"></i>Mặc định</span>
                                                }
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="openEditAddressModal(@addr.AddressId, '@Html.Raw(Html.Encode(addr.ReceiverName))', '@addr.Phone', '@Html.Raw(Html.Encode(addr.AddressLine))', @addr.IsDefault.ToString().ToLower())" title="Chỉnh sửa">
                                                    <i class="bi bi-pencil-square"></i> Sửa
                                                </button>
                                                @if (!addr.IsDefault)
                                                {
                                                    <form asp-action="SetDefaultAddress" asp-controller="Account" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="addressId" value="@addr.AddressId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Đặt làm địa chỉ mặc định">
                                                            Mặc định
                                                        </button>
                                                    </form>
                                                    <form asp-action="DeleteAddress" asp-controller="Account" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa địa chỉ này?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="addressId" value="@addr.AddressId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa địa chỉ">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-secondary small">
                                            <i class="bi bi-geo-alt me-1 text-danger"></i> @addr.AddressLine
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 border rounded-4 bg-light">
                            <i class="bi bi-geo-alt display-4 text-muted opacity-50 mb-2 d-block"></i>
                            <h6 class="fw-bold text-dark">Chưa có địa chỉ giao hàng nào</h6>
                            <p class="text-muted small mb-3">Thêm địa chỉ giao hàng giúp bạn đặt bánh nhanh hơn trong những lần mua tới.</p>
                            <button type="button" class="btn btn-bakery rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                                <i class="bi bi-plus-lg me-1"></i> Thêm Địa Chỉ Đầu Tiên
                            </button>
                        </div>
                    }
                </div>

                <!-- ================= PHẦN 3: QUẢN LÝ MẬT KHẨU ================= -->
                <div id="tab-password" class="@(activeTab == "password" ? "" : "d-none")">
                    <div class="mb-4 pb-2 border-bottom">
                        <h4 class="fw-bold mb-1" style="color: var(--bakery-dark);">Đổi Mật Khẩu Đăng Nhập</h4>
                        <p class="text-muted small mb-0">Chỉ cần nhập chính xác mật khẩu hiện tại của bạn để tiến hành thiết lập mật khẩu mới.</p>
                    </div>

                    <form asp-action="ChangePassword" asp-controller="Account" method="post" id="formChangePassword">
                        @Html.AntiForgeryToken()

                        <!-- Mật khẩu hiện tại -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input type="password" name="CurrentPassword" class="form-control" placeholder="Nhập mật khẩu bạn đang dùng" required />
                            </div>
                        </div>

                        <!-- Mật khẩu mới -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Mật khẩu mới <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                                <input type="password" name="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                            </div>
                        </div>

                        <!-- Xác nhận mật khẩu mới -->
                        <div class="mb-4">
                            <label class="form-label fw-bold small">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                                <input type="password" name="ConfirmNewPassword" class="form-control" placeholder="Nhập lại mật khẩu mới vừa gõ" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <button type="button" class="btn btn-outline-secondary px-4 py-2" onclick="activateTab('info')">
                                Hủy bỏ
                            </button>
                            <button type="submit" class="btn btn-warning px-4 py-2 fw-bold shadow-sm text-dark">
                                <i class="bi bi-key-fill me-1"></i> Cập Nhật Mật Khẩu
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL THÊM ĐỊA CHỈ MỚI ================= -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-labelledby="addAddressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="addAddressModalLabel"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Thêm Địa Chỉ Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddAddress" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Họ và tên người nhận <span class="text-danger">*</span></label>
                        <input type="text" name="ReceiverName" class="form-control" value="@Model.FullName" placeholder="Ví dụ: Nguyễn Văn A" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                        <input type="tel" name="Phone" class="form-control" value="@Model.PhoneNumber" placeholder="Ví dụ: 0912345678" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Địa chỉ nhận hàng chi tiết <span class="text-danger">*</span></label>
                        <textarea name="AddressLine" class="form-control" rows="3" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." required></textarea>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsDefault" value="true" id="addIsDefault">
                        <label class="form-check-label small" for="addIsDefault">
                            Đặt làm địa chỉ nhận hàng mặc định
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-bakery px-4 fw-bold">Lưu Địa Chỉ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL SỬA ĐỊA CHỈ ================= -->
<div class="modal fade" id="editAddressModal" tabindex="-1" aria-labelledby="editAddressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="editAddressModalLabel"><i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Địa Chỉ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateAddress" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AddressId" id="editAddressId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Họ và tên người nhận <span class="text-danger">*</span></label>
                        <input type="text" name="ReceiverName" id="editReceiverName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                        <input type="tel" name="Phone" id="editPhone" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Địa chỉ nhận hàng chi tiết <span class="text-danger">*</span></label>
                        <textarea name="AddressLine" id="editAddressLine" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsDefault" value="true" id="editIsDefault">
                        <label class="form-check-label small" for="editIsDefault">
                            Đặt làm địa chỉ nhận hàng mặc định
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-bakery px-4 fw-bold">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function activateTab(tabName) {
            $('#tab-info, #tab-address, #tab-password').addClass('d-none');
            $('#sidebar-info-btn, #sidebar-address-btn, #sidebar-password-btn').removeClass('active');

            if (tabName === 'address') {
                $('#tab-address').removeClass('d-none');
                $('#sidebar-address-btn').addClass('active');
            } else if (tabName === 'password') {
                $('#tab-password').removeClass('d-none');
                $('#sidebar-password-btn').addClass('active');
            } else {
                $('#tab-info').removeClass('d-none');
                $('#sidebar-info-btn').addClass('active');
            }
        }

        function openEditAddressModal(id, name, phone, line, isDefault) {
            $('#editAddressId').val(id);
            $('#editReceiverName').val(name);
            $('#editPhone').val(phone);
            $('#editAddressLine').val(line);
            $('#editIsDefault').prop('checked', isDefault);
            var modal = new bootstrap.Modal(document.getElementById('editAddressModal'));
            modal.show();
        }
    </script>
}
