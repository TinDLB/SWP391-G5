@model SWP391_G5.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi Mật Khẩu - Tiệm Bánh BMS";
}

<div class="container py-5" style="max-width: 900px;">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--bakery-dark);">
                <i class="bi bi-key-fill me-2" style="color: var(--bakery-primary);"></i>Đổi Mật Khẩu
            </h2>
            <p class="text-muted small mb-0">Cập nhật mật khẩu định kỳ để nâng cao tính bảo mật cho tài khoản của bạn</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
            <div>
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Menu điều hướng -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="list-group list-group-flush p-2">
                    <a asp-action="Profile" asp-controller="Account" class="list-group-item list-group-item-action rounded-3 mb-1 border-0 text-dark">
                        <i class="bi bi-person-lines-fill me-2 text-primary"></i> Thông tin cá nhân
                    </a>
                    <a asp-action="ChangePassword" asp-controller="Account" class="list-group-item list-group-item-action active rounded-3 mb-1 border-0 fw-semibold" style="background-color: var(--bakery-primary); color: white;">
                        <i class="bi bi-key-fill me-2"></i> Đổi mật khẩu
                    </a>
                    <a asp-action="Index" asp-controller="Cart" class="list-group-item list-group-item-action rounded-3 mb-1 border-0 text-dark">
                        <i class="bi bi-cart3 me-2 text-success"></i> Giỏ hàng của tôi
                    </a>
                    <form asp-action="Logout" asp-controller="Account" method="post" class="mt-2 pt-2 border-top">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="list-group-item list-group-item-action text-danger rounded-3 border-0">
                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột phải: Form đổi mật khẩu -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h4 class="fw-bold mb-4 pb-2 border-bottom" style="color: var(--bakery-dark);">
                    Thiết Lập Mật Khẩu Mới
                </h4>

                <form asp-action="ChangePassword" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder=" " id="currentPass" autofocus />
                        <label asp-for="CurrentPassword"><i class="bi bi-lock me-1"></i> Mật khẩu hiện tại</label>
                        <button type="button" class="btn btn-sm btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggleCurrentPass" tabindex="-1">
                            <i class="bi bi-eye" id="toggleCurrentIcon"></i>
                        </button>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder=" " id="newPass" />
                        <label asp-for="NewPassword"><i class="bi bi-shield-lock me-1"></i> Mật khẩu mới</label>
                        <button type="button" class="btn btn-sm btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggleNewPass" tabindex="-1">
                            <i class="bi bi-eye" id="toggleNewIcon"></i>
                        </button>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4 position-relative">
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder=" " id="confirmPass" />
                        <label asp-for="ConfirmNewPassword"><i class="bi bi-shield-check me-1"></i> Xác nhận mật khẩu mới</label>
                        <button type="button" class="btn btn-sm btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggleConfirmPass" tabindex="-1">
                            <i class="bi bi-eye" id="toggleConfirmIcon"></i>
                        </button>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Profile" asp-controller="Account" class="btn btn-outline-secondary px-4 py-2">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-bakery px-4 py-2">
                            <i class="bi bi-check2-circle me-1"></i> Cập Nhật Mật Khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setupToggle(btnId, inputId, iconId) {
            const btn = document.getElementById(btnId);
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (btn && input && icon) {
                btn.addEventListener('click', function () {
                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    icon.classList.toggle('bi-eye', !isPassword);
                    icon.classList.toggle('bi-eye-slash', isPassword);
                });
            }
        }
        setupToggle('toggleCurrentPass', 'currentPass', 'toggleCurrentIcon');
        setupToggle('toggleNewPass', 'newPass', 'toggleNewIcon');
        setupToggle('toggleConfirmPass', 'confirmPass', 'toggleConfirmIcon');
    </script>
}
