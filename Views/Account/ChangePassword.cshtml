@model SWP391_G5.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi Mật Khẩu - Tiệm Bánh BMS";
}

<div class="container py-5" style="max-width: 980px;">
    <div class="mb-4 pb-3 border-bottom">
        <h2 class="fw-bold mb-0" style="color: var(--bakery-dark);">
            <i class="bi bi-key-fill me-2" style="color: var(--bakery-primary);"></i>Quản Lý Mật Khẩu
        </h2>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm border-0" role="alert" style="border-left: 5px solid #dc3545 !important;">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5 text-danger"></i>
            <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
            <div>
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Menu điều hướng -->
        <div class="col-lg-4 col-md-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
                <div class="list-group list-group-flush p-2">
                    <a asp-action="Profile" asp-controller="Account" class="list-group-item list-group-item-action rounded-3 mb-1 border-0 text-dark d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-person-lines-fill me-2 text-primary"></i> Thông tin cá nhân</span>
                        <i class="bi bi-chevron-right small opacity-50"></i>
                    </a>
                    <a asp-action="Profile" asp-controller="Account" asp-route-tab="password" class="list-group-item list-group-item-action active rounded-3 mb-1 border-0 fw-semibold d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, var(--bakery-primary), var(--bakery-secondary)); color: white;">
                        <span><i class="bi bi-key-fill me-2"></i> Quản lý mật khẩu</span>
                        <i class="bi bi-chevron-right small opacity-50"></i>
                    </a>
                    <form asp-action="Logout" asp-controller="Account" method="post" class="mt-2 pt-2 border-top">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="list-group-item list-group-item-action text-danger rounded-3 border-0 w-100 text-start">
                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột phải: Form đổi mật khẩu -->
        <div class="col-lg-8 col-md-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h4 class="fw-bold mb-4 pb-2 border-bottom" style="color: var(--bakery-dark);">
                    Thiết Lập Mật Khẩu Mới
                </h4>

                <form asp-action="ChangePassword" asp-controller="Account" method="post" id="formStandaloneChangePass">
                    @Html.AntiForgeryToken()

                    <div class="alert alert-light border small text-muted mb-4 d-flex align-items-center">
                        <i class="bi bi-shield-lock-fill me-2 fs-5 text-warning"></i>
                        <div>Bạn chỉ cần nhập chính xác mật khẩu hiện tại và tạo mật khẩu mới (tối thiểu 6 ký tự).</div>
                    </div>

                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder=" " id="currentPassStandalone" autofocus required />
                        <label asp-for="CurrentPassword"><i class="bi bi-lock me-1"></i> Mật khẩu hiện tại <span class="text-danger">*</span></label>
                        <button type="button" class="btn btn-sm btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggleCurrentPassStandalone" tabindex="-1">
                            <i class="bi bi-eye" id="toggleCurrentIconStandalone"></i>
                        </button>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder=" " id="newPassStandalone" required minlength="6" />
                        <label asp-for="NewPassword"><i class="bi bi-shield-lock me-1"></i> Mật khẩu mới (ít nhất 6 ký tự) <span class="text-danger">*</span></label>
                        <button type="button" class="btn btn-sm btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggleNewPassStandalone" tabindex="-1">
                            <i class="bi bi-eye" id="toggleNewIconStandalone"></i>
                        </button>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4 position-relative">
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder=" " id="confirmPassStandalone" required />
                        <label asp-for="ConfirmNewPassword"><i class="bi bi-shield-check me-1"></i> Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                        <button type="button" class="btn btn-sm btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggleConfirmPassStandalone" tabindex="-1">
                            <i class="bi bi-eye" id="toggleConfirmIconStandalone"></i>
                        </button>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Profile" asp-controller="Account" class="btn btn-outline-secondary px-4 py-2">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-bakery px-4 py-2 shadow-sm">
                            <i class="bi bi-key-fill me-1"></i> Cập Nhật Mật Khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setupToggle(btnId, inputId, iconId) {
            const btn = document.getElementById(btnId);
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (btn && input && icon) {
                btn.addEventListener('click', function () {
                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    icon.classList.toggle('bi-eye', !isPassword);
                    icon.classList.toggle('bi-eye-slash', isPassword);
                });
            }
        }
        setupToggle('toggleCurrentPassStandalone', 'currentPassStandalone', 'toggleCurrentIconStandalone');
        setupToggle('toggleNewPassStandalone', 'newPassStandalone', 'toggleNewIconStandalone');
        setupToggle('toggleConfirmPassStandalone', 'confirmPassStandalone', 'toggleConfirmIconStandalone');
    </script>
}
