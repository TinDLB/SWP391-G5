@model SWP391_G5.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu - Tiệm Bánh BMS";
}

<div class="auth-wrapper">
    <div class="auth-card" style="max-width: 500px; margin: 0 auto;">
        <div class="auth-form-side p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 70px; height: 70px; background-color: var(--bakery-cream); color: var(--bakery-primary); border: 2px solid var(--bakery-secondary);">
                    <i class="bi bi-shield-check fs-1"></i>
                </div>
                <h2 class="fw-bold" style="color: var(--bakery-dark);">Đặt Lại Mật Khẩu</h2>
                <p class="text-muted small">
                    Tạo mật khẩu mới cho tài khoản: <strong class="text-dark">@Model.Email</strong>
                </p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="ResetPassword" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div class="form-floating mb-3 position-relative">
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder=" " id="newPass" autofocus />
                    <label asp-for="NewPassword"><i class="bi bi-lock me-1"></i> Mật khẩu mới</label>
                    <button type="button" class="btn btn-sm btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggleNewPass" tabindex="-1">
                        <i class="bi bi-eye" id="toggleNewIcon"></i>
                    </button>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4 position-relative">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder=" " id="confirmPass" />
                    <label asp-for="ConfirmPassword"><i class="bi bi-shield-lock me-1"></i> Xác nhận mật khẩu mới</label>
                    <button type="button" class="btn btn-sm btn-link position-absolute end-0 top-50 translate-middle-y me-2 text-muted text-decoration-none" id="toggleConfirmPass" tabindex="-1">
                        <i class="bi bi-eye" id="toggleConfirmIcon"></i>
                    </button>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-bakery w-100 py-3 mb-3">
                    <i class="bi bi-check2-circle me-1"></i> Lưu Mật Khẩu Mới
                </button>

                <div class="text-center mt-3 pt-3 border-top">
                    <a asp-action="Login" asp-controller="Account" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng Nhập
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setupToggle(btnId, inputId, iconId) {
            const btn = document.getElementById(btnId);
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (btn && input && icon) {
                btn.addEventListener('click', function () {
                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    icon.classList.toggle('bi-eye', !isPassword);
                    icon.classList.toggle('bi-eye-slash', isPassword);
                });
            }
        }
        setupToggle('toggleNewPass', 'newPass', 'toggleNewIcon');
        setupToggle('toggleConfirmPass', 'confirmPass', 'toggleConfirmIcon');
    </script>
}
