@using SWP391_G5.Models.ViewModels
@model VoucherEditViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Code" class="form-label">Mã voucher</label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="DiscountType" class="form-label">Loại giảm</label><select asp-for="DiscountType" class="form-select"><option value="Percent">Phần trăm (%)</option><option value="Fixed">Số tiền cố định</option></select></div>
            <div class="col-md-6"><label asp-for="DiscountValue" class="form-label">Giá trị giảm</label><input asp-for="DiscountValue" asp-format="{0:0.##}" class="form-control" min="0.01" step="0.01" /><span asp-validation-for="DiscountValue" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="MinOrderValue" class="form-label">Đơn tối thiểu</label><input asp-for="MinOrderValue" asp-format="{0:0.##}" class="form-control" min="0" step="1000" /></div>
            <div class="col-md-6"><label asp-for="MaxDiscount" class="form-label">Giảm tối đa (VNĐ, chỉ Percent)</label><input asp-for="MaxDiscount" asp-format="{0:0.##}" class="form-control" type="number" min="0.01" step="0.01" /><span asp-validation-for="MaxDiscount" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="UsageLimit" class="form-label">Giới hạn lượt dùng</label><input asp-for="UsageLimit" class="form-control" min="1" /></div>
            <div class="col-md-6"><label asp-for="StartDate" class="form-label">Ngày bắt đầu</label><input asp-for="StartDate" type="date" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="EndDate" class="form-label">Ngày kết thúc</label><input asp-for="EndDate" type="date" class="form-control" /></div>
            <div class="col-12 form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Đang hoạt động</label></div>
        </div>
    </div>
</div>
