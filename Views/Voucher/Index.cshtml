@using SWP391_G5.Models.ViewModels
@model IEnumerable<VoucherListItemViewModel>
@{ ViewData["Title"] = "Quản lý voucher"; ViewData["PageTitle"] = "Quản lý voucher"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h4>Mã giảm giá</h4><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm voucher</a></div><form method="get" class="row g-2 mb-3"><div class="col-md-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm mã voucher..." /></div><div class="col-md-3"><select name="status" class="form-select"><option value="">Tất cả trạng thái</option><option value="active">Đang dùng</option><option value="upcoming">Chưa bắt đầu</option><option value="expired">Đã hết hạn</option><option value="exhausted">Hết lượt</option><option value="inactive">Đã tắt</option></select></div><div class="col-auto"><button class="btn btn-outline-secondary">Lọc</button></div></form><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Mã</th><th>Giảm</th><th>Thời gian</th><th>Lượt dùng</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-5">Chưa có voucher.</td></tr>}else{@foreach(var v in Model){<tr><td class="fw-bold">@v.Code</td><td>@(v.DiscountType == "Percent" ? $"{v.DiscountValue:N0}%" : $"{v.DiscountValue:N0} đ")</td><td>@v.StartDate.ToString("dd/MM/yyyy") - @v.EndDate.ToString("dd/MM/yyyy")</td><td>@v.UsedCount / @(v.UsageLimit?.ToString() ?? "?")</td><td>@v.Status</td><td class="text-end"><a asp-action="Edit" asp-route-id="@v.VoucherId" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a><form asp-action="ToggleStatus" asp-route-id="@v.VoucherId" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary"><i class="bi bi-power"></i></button></form></td></tr>}}</tbody></table></div></div>
