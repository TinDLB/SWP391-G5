                        </div>

                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-bakery w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <span>TIáº¾N HÃ€NH Äáº¶T HÃ€NG</span>
