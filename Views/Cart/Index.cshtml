                                <thead class="table-light small text-uppercase">
                                    <tr>
                                        <th>Sáº£n pháº©m</th>
                                        <th>ÄÆ¡n giÃ¡</th>
                                        <th class="text-center" style="width: 140px;">Sá»‘ lÆ°á»£ng</th>
                                        <th class="text-end">ThÃ nh tiá»n</th>
