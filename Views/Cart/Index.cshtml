@section Scripts {
    <script>
        function changeQty(productId, delta) {
            var input = $('#qty_' + productId);
            var current = parseInt(input.val()) || 1;
            var newQty = current + delta;
            if (newQty < 1) {
                if (confirm('Báº¡n cÃ³ muá»‘n xÃ³a sáº£n pháº©m nÃ y khá»i giá» hÃ ng khÃ´ng?')) {
                    removeCartItem(productId);
                }
                return;
            }

            $.post('/Cart/UpdateQuantity', { productId: productId, quantity: newQty }, function(res) {
                if (res.success) {
                    input.val(res.quantity);
                    $('#lineTotal_' + productId).text(res.formattedLineTotal);
                    $('#headerCartCount').text(res.cartCount);
                    recalculateSummary(res.cartTotal);
                } else {
                    alert(res.message);
                }
            }).fail(function() {
                alert('CÃ³ lá»—i xáº£y ra, vui lÃ²ng thá»­ láº¡i!');
            });
        }

        function removeCartItem(productId) {
            $.post('/Cart/RemoveItem', { productId: productId }, function(res) {
                if (res.success) {
                    $('#cartRow_' + productId).fadeOut(300, function() {
                        $(this).remove();
                        $('#headerCartCount').text(res.cartCount);
                        if (res.isEmpty) {
                            location.reload();
                        } else {
                            recalculateSummary(res.cartTotal);
                        }
                    });
                }
            }).fail(function() {
                alert('CÃ³ lá»—i xáº£y ra, vui lÃ²ng thá»­ láº¡i!');
            });
        }

        function recalculateSummary(subtotal) {
            var ship = (subtotal >= 200000 || subtotal === 0) ? 0 : 25000;
            var grand = subtotal + ship;
            $('#cartSubtotal').text(subtotal.toLocaleString('vi-VN') + ' Ä‘');
            $('#cartShippingFee').text(ship === 0 ? 'Miá»…n phÃ­' : ship.toLocaleString('vi-VN') + ' Ä‘');
            $('#cartGrandTotal').text(grand.toLocaleString('vi-VN') + ' Ä‘');
        }
    </script>
}
