            <form asp-controller="Cart" asp-action="ClearCart" method="post" onsubmit="return confirm('Báº¡n cÃ³ cháº¯c muá»‘n lÃ m trá»‘ng giá» hÃ ng?');">
                @Html.AntiForgeryToken()
