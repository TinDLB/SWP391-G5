@model SWP391_G5.Models.ViewModels.IngredientListViewModel
@{
    ViewData["Title"] = "Kho nguyên liệu";
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-basket-fill text-warning me-2"></i>Kho nguyên liệu
        </h4>
        <p class="text-muted small mb-0">Theo dõi lượng tồn nguyên liệu dùng cho các mẻ làm bánh.</p>
    </div>
    @if (isAdmin)
    {
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Thêm nguyên liệu mới
            </a>
        </div>
    }
</div>

<!-- Bộ lọc tab & Ô tìm kiếm -->
<div class="card stat-card mb-4 border-0">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-7">
                <ul class="nav nav-pills small">
                    <li class="nav-item">
                        <a class="nav-link @(Model.Filter == "active" ? "active" : "")"
                           asp-action="Index" asp-route-filter="active" asp-route-keyword="@Model.Keyword">
                            Đang dùng <span class="badge bg-secondary ms-1">@Model.ActiveCount</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.Filter == "low" ? "active bg-danger" : "text-danger")"
                           asp-action="Index" asp-route-filter="low" asp-route-keyword="@Model.Keyword">
                            <i class="bi bi-exclamation-triangle me-1"></i>Sắp hết / Tồn thấp
                            <span class="badge @(Model.Filter == "low" ? "bg-white text-danger" : "bg-danger") ms-1">@Model.LowCount</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.Filter == "inactive" ? "active" : "")"
                           asp-action="Index" asp-route-filter="inactive" asp-route-keyword="@Model.Keyword">
                            Đã ngừng dùng <span class="badge bg-secondary ms-1">@Model.InactiveCount</span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-12 col-md-5">
                <form method="get" asp-action="Index" class="d-flex">
                    <input type="hidden" name="filter" value="@Model.Filter" />
                    <div class="input-group input-group-sm">
                        <input type="text" name="keyword" class="form-control" placeholder="Tìm tên nguyên liệu..." value="@Model.Keyword" />
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>
                        </button>
                        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                        {
                            <a asp-action="Index" asp-route-filter="@Model.Filter" class="btn btn-outline-danger">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách nguyên liệu -->
@if (Model.Items == null || !Model.Items.Any())
{
    <div class="alert alert-info rounded-3 text-center py-4">
        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
        Không tìm thấy nguyên liệu nào phù hợp với bộ lọc hiện tại.
    </div>
}
else
{
    <div class="card stat-card border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">#ID</th>
                        <th>Tên nguyên liệu</th>
                        <th class="text-center" style="width: 100px;">Đơn vị</th>
                        <th class="text-end" style="width: 140px;">Tồn kho</th>
                        <th class="text-end" style="width: 140px;">Ngưỡng tối thiểu</th>
                        <th class="text-center" style="width: 140px;">Tình trạng</th>
                        <th class="text-center" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsLow ? "table-danger bg-opacity-25" : "")">
                            <td class="text-muted fw-semibold">#@item.IngredientId</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.IngredientId" class="fw-semibold text-decoration-none text-dark">
                                    @item.Name
                                </a>
                            </td>
                            <td class="text-center"><span class="badge bg-light text-dark border">@item.Unit</span></td>
                            <td class="text-end fw-bold @(item.IsLow ? "text-danger" : "text-success")">
                                @item.StockQty.ToString("#,##0.###") @item.Unit
                            </td>
                            <td class="text-end text-muted">
                                @item.MinThreshold.ToString("#,##0.###") @item.Unit
                            </td>
                            <td class="text-center">
                                @if (!item.IsActive)
                                {
                                    <span class="badge bg-secondary">Ngừng dùng</span>
                                }
                                else if (item.IsLow)
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-exclamation-circle me-1"></i>Tồn thấp
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-75">Đầy đủ</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.IngredientId" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (isAdmin)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.IngredientId" class="btn btn-sm btn-outline-secondary ms-1" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@{ ViewData["Title"]="Quản lý nguyên liệu"; Layout="~/Views/Shared/_AdminLayout.cshtml"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
<div><h3 class="mb-1">Quản lý nguyên liệu</h3><p class="text-muted mb-0">Theo dõi tồn kho và thông tin nguyên liệu làm bánh.</p></div>
<div class="d-flex gap-2"><a asp-controller="StockAdjustment" asp-action="Index" class="btn btn-outline-primary">Điều chỉnh tồn kho</a><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm nguyên liệu</a></div>
</div>
<form method="get" class="card card-body border-0 shadow-sm mb-4"><div class="row g-3 align-items-end">
<div class="col-md-5"><label for="search" class="form-label">Tìm nguyên liệu</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Tên hoặc đơn vị tính" /></div>
<div class="col-md-3"><label for="status" class="form-label">Trạng thái</label><select id="status" name="status" class="form-select"><option value="">Tất cả</option><option value="active" selected="@(Model.Status=="active")">Đang hoạt động</option><option value="inactive" selected="@(Model.Status=="inactive")">Ngừng hoạt động</option></select></div>
<div class="col-md-2"><div class="form-check mb-2"><input id="lowStock" name="lowStock" value="true" type="checkbox" checked="@Model.LowStock" class="form-check-input" /><label for="lowStock" class="form-check-label">Tồn thấp</label></div></div>
<div class="col-md-2 d-flex gap-2"><button class="btn btn-primary">Lọc</button><a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a></div>
</div></form>
<p class="text-muted">@Model.Items.Count nguyên liệu phù hợp · Tồn thấp: số lượng tồn nhỏ hơn hoặc bằng ngưỡng tối thiểu.</p>
<div class="table-responsive bg-white shadow-sm rounded"><table class="table table-hover align-middle mb-0">
<thead><tr><th>Nguyên liệu</th><th>Tồn kho</th><th>Đơn vị</th><th>Ngưỡng tối thiểu</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var item in Model.Items) {
<tr><td class="fw-semibold">@item.Name</td><td>@item.StockQty.ToString("N0") @if(item.StockQty<=item.MinThreshold) {<span class="badge bg-warning text-dark ms-1">Tồn thấp</span>}</td><td>@item.Unit</td><td>@item.MinThreshold.ToString("N0")</td>
<td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")</span></td>
<td><div class="d-flex gap-2">
@if(item.IsActive) {
<a asp-controller="StockAdjustment" asp-action="Index" asp-route-ingredientId="@item.IngredientId" class="btn btn-sm btn-outline-success">Điều chỉnh</a>
}
<a asp-action="Edit" asp-route-id="@item.IngredientId" class="btn btn-sm btn-outline-primary">Sửa</a>
<form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@item.IngredientId"/><input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")"/><button class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")" onclick="return confirm('Xác nhận thay đổi trạng thái nguyên liệu?')">@(item.IsActive ? "Ngừng sử dụng" : "Kích hoạt")</button></form></div></td></tr>
}
@if(Model.Items.Count==0) {<tr><td colspan="6" class="text-center text-muted p-4">Không tìm thấy nguyên liệu.</td></tr>}
</tbody></table></div>

