@model IEnumerable<SWP391_G5.Models.Entities.Product>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Thực Đơn Bánh - Bakery Management System";
    var categories = ViewBag.Categories as IEnumerable<SWP391_G5.Models.Entities.Category> ?? Enumerable.Empty<SWP391_G5.Models.Entities.Category>();
    string? keyword = ViewBag.Keyword as string;
    int? currentCatId = ViewBag.CategoryId as int?;
    decimal? minPrice = ViewBag.MinPrice as decimal?;
    decimal? maxPrice = ViewBag.MaxPrice as decimal?;
    string? priceRange = ViewBag.PriceRange as string;
    string sort = ViewBag.Sort as string ?? "";
    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    int totalItems = ViewBag.TotalItems is int ti ? ti : 0;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang Chủ</a></li>
            <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">Thực Đơn Bánh</li>
        </ol>
    </nav>

    <!-- Header & Filter Bar -->
    <div class="bg-white p-3 p-md-4 rounded-4 shadow-sm border mb-4">
        <form method="get" asp-controller="Product" asp-action="Index" class="row g-3 align-items-end" id="filterForm">
            <!-- Keyword -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-search me-1"></i> Tìm kiếm bánh</label>
                <input type="text" name="keyword" value="@keyword" class="form-control rounded-pill" placeholder="Tên bánh, hương vị, mô tả..." />
            </div>

            <!-- Category -->
            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-tag-fill me-1"></i> Danh mục</label>
                <select name="categoryId" class="form-select rounded-pill">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryId" selected="@(currentCatId == c.CategoryId)">@c.Name</option>
                    }
                </select>
            </div>

            <!-- Price Range -->
            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-cash-stack me-1"></i> Khoảng giá</label>
                <select name="priceRange" class="form-select rounded-pill">
                    <option value="" selected="@(string.IsNullOrEmpty(priceRange))">Tất cả mức giá</option>
                    <option value="under50" selected="@(priceRange == "under50")">Dưới 50.000đ</option>
                    <option value="50to100" selected="@(priceRange == "50to100")">50.000đ - 100.000đ</option>
                    <option value="100to200" selected="@(priceRange == "100to200")">100.000đ - 200.000đ</option>
                    <option value="200to300" selected="@(priceRange == "200to300")">200.000đ - 300.000đ</option>
                    <option value="300to400" selected="@(priceRange == "300to400")">300.000đ - 400.000đ</option>
                    <option value="over400" selected="@(priceRange == "over400")">Trên 400.000đ</option>
                </select>
            </div>

            <!-- Sort -->
            <div class="col-lg-2 col-md-6">
                <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-sort-down me-1"></i> Sắp xếp</label>
                <select name="sort" class="form-select rounded-pill">
                    <option value="" selected="@(string.IsNullOrEmpty(sort))">Mới nhất</option>
                    <option value="price_asc" selected="@(sort == "price_asc")">Giá thấp → cao</option>
                    <option value="price_desc" selected="@(sort == "price_desc")">Giá cao → thấp</option>
                    <option value="name_asc" selected="@(sort == "name_asc")">Tên A → Z</option>
                </select>
            </div>

            <!-- Filter Buttons -->
            <div class="col-12 d-flex justify-content-between align-items-center pt-2 border-top flex-wrap gap-2">
                <div class="text-muted small">
                    Tìm thấy <strong class="text-dark">@totalItems</strong> sản phẩm bánh tươi phù hợp
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa lọc
                    </a>
                    <button type="submit" class="btn btn-sm btn-bakery rounded-pill px-4 fw-bold">
                        <i class="bi bi-funnel-fill me-1"></i> Áp dụng bộ lọc
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Product Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var p in Model)
            {
                var imgPath = $"/uploads/products/{p.ProductId}.jpg";
                var fullLocalPath = System.IO.Path.Combine(HostEnvironment.WebRootPath, "uploads", "products", $"{p.ProductId}.jpg");
                if (!System.IO.File.Exists(fullLocalPath))
                {
                    imgPath = !string.IsNullOrWhiteSpace(p.ImageUrl) ? p.ImageUrl : "/uploads/products/1.jpg";
                }

                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-item-card transition-all" style="background: #ffffff; border: 1px solid #f0e6d8 !important;">
                        <!-- Ảnh bánh -->
                        <div class="position-relative overflow-hidden" style="height: 230px; background: #faf3e0;">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.ProductId" class="d-block w-100 h-100">
                                <img src="@Url.Content("~" + imgPath)" alt="@p.Name" class="w-100 h-100 object-fit-cover" loading="lazy" />
                            </a>
                            @if (p.StockQty <= 0)
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-2 rounded-pill shadow-sm">Hết hàng</span>
                            }
                            else
                            {
                                <span class="badge bg-success bg-opacity-75 position-absolute top-0 start-0 m-2 rounded-pill shadow-sm">Còn hàng</span>
                            }
                            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2 rounded-pill shadow-sm">
                                @(p.Category?.Name ?? "Bánh")
                            </span>
                        </div>

                        <!-- Thân Card -->
                        <div class="card-body p-3 d-flex flex-column">
                            <h6 class="fw-bold mb-1 text-truncate-2" style="min-height: 40px; line-height: 1.3;">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.ProductId" class="text-decoration-none text-dark hover-primary">
                                    @p.Name
                                </a>
                            </h6>

                            <p class="text-muted small mb-3 text-truncate" style="max-height: 20px;">
                                @(string.IsNullOrEmpty(p.Description) ? "Bánh tươi làm mới mỗi ngày" : p.Description)
                            </p>

                            <!-- Giá + Nút giỏ hàng -->
                            <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
                                <div class="fw-bold fs-5" style="color: var(--bakery-primary);">
                                    @p.Price.ToString("N0") <small class="fs-6 text-muted">đ</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-bakery rounded-circle shadow-sm" style="width: 38px; height: 38px;" onclick="addToCart(@p.ProductId, 1)" title="Thêm vào giỏ hàng">
                                    <i class="bi bi-cart-plus-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-search display-3 text-muted opacity-50 mb-3 d-block"></i>
                <h5 class="fw-bold text-dark">Không tìm thấy sản phẩm bánh phù hợp</h5>
                <p class="text-muted small">Hãy thử tìm kiếm với từ khóa khác hoặc xóa bỏ các tiêu chí lọc giá/danh mục.</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-bakery rounded-pill px-4">
                    <i class="bi bi-arrow-repeat me-1"></i> Xem tất cả bánh
                </a>
            </div>
        }
    </div>

    <!-- Phân trang -->
    @if (totalPages > 1)
    {
        <nav aria-label="Phân trang sản phẩm" class="mt-5">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link rounded-pill me-1" asp-controller="Product" asp-action="Index"
                       asp-route-page="@(currentPage - 1)" asp-route-keyword="@keyword" asp-route-categoryId="@currentCatId"
                       asp-route-priceRange="@priceRange" asp-route-sort="@sort">
                        <i class="bi bi-chevron-left me-1"></i> Trước
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link rounded-circle mx-1" asp-controller="Product" asp-action="Index"
                           asp-route-page="@i" asp-route-keyword="@keyword" asp-route-categoryId="@currentCatId"
                           asp-route-priceRange="@priceRange" asp-route-sort="@sort">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link rounded-pill ms-1" asp-controller="Product" asp-action="Index"
                       asp-route-page="@(currentPage + 1)" asp-route-keyword="@keyword" asp-route-categoryId="@currentCatId"
                       asp-route-priceRange="@priceRange" asp-route-sort="@sort">
                        Sau <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<style>
    .product-item-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(198, 105, 0, 0.15) !important;
    }
    .hover-primary:hover {
        color: var(--bakery-primary) !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
