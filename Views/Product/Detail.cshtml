</div>

@section Scripts {
    <script>
        function incQty() {
            var input = document.getElementById('detailQty');
            var max = parseInt(input.getAttribute('max')) || 99;
            var val = parseInt(input.value) || 1;
            if (val < max) input.value = val + 1;
        }

        function decQty() {
            var input = document.getElementById('detailQty');
            var val = parseInt(input.value) || 1;
            if (val > 1) input.value = val - 1;
        }

        function buyNow(productId) {
            var qty = parseInt(document.getElementById('detailQty').value) || 1;
            $.post('/Cart/AddToCart', { productId: productId, quantity: qty }, function(res) {
                if (res.success) {
                    window.location.href = '/Cart';
                } else {
                    alert(res.message);
                }
            }).fail(function() {
                alert('CÃ³ lá»—i xáº£y ra, vui lÃ²ng thá»­ láº¡i!');
            });
        }
    </script>
}
