@model SWP391_G5.Models.Entities.Product
@{
    ViewData["Title"] = Model.Name + " - Bakery Management System";
    var related = ViewBag.RelatedProducts as IEnumerable<SWP391_G5.Models.Entities.Product> ?? Enumerable.Empty<SWP391_G5.Models.Entities.Product>();
    string img = string.IsNullOrEmpty(Model.ImageUrl) 
        ? "https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=600&auto=format&fit=crop&q=80" 
        : Model.ImageUrl;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" class="text-decoration-none text-muted">Thực Đơn</a></li>
            <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Product Detail Box -->
    <div class="bg-white p-4 p-lg-5 rounded-4 shadow-sm border mb-5">
        <div class="row g-5 align-items-center">
            <!-- Ảnh sản phẩm -->
            <div class="col-md-6 text-center">
                <div class="product-detail-img-box rounded-4 overflow-hidden border p-2 bg-light">
                    <img src="@img" alt="@Model.Name" class="img-fluid rounded-4 shadow-sm" style="max-height: 420px; object-fit: cover; width: 100%;" />
                </div>
            </div>

            <!-- Thông tin sản phẩm -->
            <div class="col-md-6">
                <div class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">
                    @(Model.Category?.Name ?? "Bánh tươi")
                </div>
                <h2 class="fw-bold text-dark mb-2">@Model.Name</h2>
                <div class="text-muted small mb-3">Mã sản phẩm: <strong>SP0@(Model.ProductId)</strong> | Hotline tư vấn: <strong class="text-dark">0961 452 578</strong></div>

                <div class="fs-2 fw-bold mb-3" style="color: var(--bakery-primary);">
                    @Model.Price.ToString("N0") <span class="fs-5">đ</span>
                </div>

                <p class="text-secondary mb-4 lh-base">
                    @(string.IsNullOrEmpty(Model.Description) ? "Bánh được chế biến từ 100% nguyên liệu bơ sữa tươi hảo hạng, nướng mới mỗi sáng với công thức độc quyền từ nghệ nhân Bakery Management System." : Model.Description)
                </p>

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="fw-semibold text-muted">Số lượng:</div>
                    <div class="input-group" style="width: 130px;">
                        <button type="button" class="btn btn-outline-secondary" onclick="decQty()">-</button>
                        <input type="number" id="detailQty" class="form-control text-center fw-bold" value="1" min="1" max="@Model.StockQty" />
                        <button type="button" class="btn btn-outline-secondary" onclick="incQty()">+</button>
                    </div>
                    <small class="text-muted">(@Model.StockQty sản phẩm có sẵn)</small>
                </div>

                <div class="d-flex gap-3 flex-wrap">
                    <button type="button" class="btn btn-dark rounded-pill px-4 py-3 fw-bold flex-grow-1" onclick="addToCart(@Model.ProductId, parseInt($('#detailQty').val()) || 1)">
                        <i class="bi bi-cart-plus-fill me-2"></i> THÊM VÀO GIỎ HÀNG
                    </button>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-warning rounded-pill px-4 py-3 fw-bold">
                        ĐẾN GIỎ HÀNG
                    </a>
                </div>

                <div class="border-top mt-4 pt-3 text-muted small">
                    <div><i class="bi bi-check-circle-fill text-success me-2"></i> Giao hàng tận nơi hỏa tốc trong 2 giờ tại Hà Nội</div>
                    <div class="mt-1"><i class="bi bi-check-circle-fill text-success me-2"></i> Tặng kèm bộ dao, thìa, nến sinh nhật cao cấp</div>
                    <div class="mt-1"><i class="bi bi-check-circle-fill text-success me-2"></i> Viết lời chúc và trang trí theo yêu cầu miễn phí</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related != null && related.Any())
    {
        <h4 class="fw-bold text-dark mb-4 border-start border-4 border-danger ps-3">SẢN PHẨM CÙNG LOẠI</h4>
        <div class="row g-4">
            @foreach (var r in related)
            {
                string rImg = string.IsNullOrEmpty(r.ImageUrl) 
                    ? "https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=600&auto=format&fit=crop&q=80" 
                    : r.ImageUrl;
                <div class="col-6 col-md-3">
                    <div class="cake-product-card h-100 shadow-sm">
                        <div class="cake-img-wrapper">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@r.ProductId">
                                <img src="@rImg" alt="@r.Name" class="img-fluid cake-card-img" />
                            </a>
                        </div>
                        <div class="cake-card-body p-3 text-center">
                            <h6 class="cake-product-name mb-2">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@r.ProductId" class="text-decoration-none text-dark">
                                    @r.Name.ToUpper()
                                </a>
                            </h6>
                            <div class="cake-price-cart-bar d-flex align-items-stretch">
                                <div class="cake-price-lime-badge flex-grow-1 d-flex align-items-center justify-content-center">
                                    <span>@r.Price.ToString("N0")đ</span>
                                </div>
                                <button type="button" class="btn cake-cart-brown-btn" onclick="addToCart(@r.ProductId, 1)">
                                    <i class="bi bi-cart-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function incQty() {
            let val = parseInt($('#detailQty').val()) || 1;
            $('#detailQty').val(val + 1);
        }
        function decQty() {
            let val = parseInt($('#detailQty').val()) || 1;
            if (val > 1) $('#detailQty').val(val - 1);
        }
    </script>
}
