@using SWP391_G5.Models.Entities
@model IEnumerable<PurchaseOrder>

@{
    ViewData["Title"] = "Đơn mua hàng";
    ViewData["PageTitle"] = "Quản lý đơn mua hàng từ Nhà cung cấp";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var suppliers = ViewBag.Suppliers as IEnumerable<Supplier> ?? Enumerable.Empty<Supplier>();
    int? selSupplierId = ViewBag.SupplierId as int?;
    string? selStatus = ViewBag.Status as string;

    int totalOrders = ViewBag.TotalOrders ?? 0;
    int totalDraft = ViewBag.TotalDraft ?? 0;
    int totalSent = ViewBag.TotalSent ?? 0;
    int totalPartially = ViewBag.TotalPartially ?? 0;
    int totalCompleted = ViewBag.TotalCompleted ?? 0;
    decimal totalAmountSum = ViewBag.TotalAmountSum ?? 0;
}

<!-- ── Stat Cards ── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Tổng đơn đặt</div>
                <div class="fw-bold fs-4 text-dark mt-1">@totalOrders</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Bản nháp</div>
                <div class="fw-bold fs-4 text-secondary mt-1">@totalDraft</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Đã gửi NCC</div>
                <div class="fw-bold fs-4 text-primary mt-1">@totalSent</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Giao 1 phần</div>
                <div class="fw-bold fs-4 text-warning mt-1">@totalPartially</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Hoàn thành</div>
                <div class="fw-bold fs-4 text-success mt-1">@totalCompleted</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4 col-xl-2">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
            <div class="card-body p-3">
                <div class="text-muted small">Tổng giá trị đặt</div>
                <div class="fw-bold fs-5 text-danger mt-1 text-truncate" title="@totalAmountSum.ToString("N0") đ">
                    @totalAmountSum.ToString("N0") <small class="fs-6">đ</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Main Card: Filter & Table ── -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h5 class="fw-bold mb-1">Danh sách đơn mua hàng</h5>
                <p class="text-muted small mb-0">Theo dõi tiến độ đặt hàng và giao hàng từ các đối tác cung ứng</p>
            </div>
            <a asp-action="Create" class="btn text-white px-3 py-2 rounded-3 d-inline-flex align-items-center gap-2"
               style="background-color: #e8621a;">
                <i class="bi bi-plus-lg"></i>
                <span class="fw-medium">Lập đơn đặt hàng mới</span>
            </a>
        </div>

        <!-- Filter Form -->
        <form method="get" class="row g-2 mb-4 p-3 bg-light rounded-3">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Nhà cung cấp</label>
                <select name="supplierId" class="form-select form-select-sm rounded-2">
                    <option value="">-- Tất cả nhà cung cấp --</option>
                    @foreach (var s in suppliers)
                    {
                        if (selSupplierId == s.SupplierId)
                        {
                            <option value="@s.SupplierId" selected>@s.Name</option>
                        }
                        else
                        {
                            <option value="@s.SupplierId">@s.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Trạng thái</label>
                <select name="status" class="form-select form-select-sm rounded-2">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Draft" selected="@(selStatus == "Draft")">Bản nháp (Draft)</option>
                    <option value="Sent" selected="@(selStatus == "Sent")">Đã gửi (Sent)</option>
                    <option value="PartiallyFulfilled" selected="@(selStatus == "PartiallyFulfilled")">Giao một phần (PartiallyFulfilled)</option>
                    <option value="Completed" selected="@(selStatus == "Completed")">Hoàn thành (Completed)</option>
                    <option value="Cancelled" selected="@(selStatus == "Cancelled")">Đã hủy (Cancelled)</option>
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-sm btn-primary px-3 rounded-2">
                    <i class="bi bi-filter me-1"></i> Lọc đơn
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3 rounded-2">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                </a>
            </div>
        </form>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-secondary">
                    <tr>
                        <th class="ps-3">Mã đơn PO</th>
                        <th>Nhà cung cấp</th>
                        <th>Ngày đặt</th>
                        <th>Ngày dự kiến</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Người tạo</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-3">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var po in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <a asp-action="Details" asp-route-id="@po.PoId" class="fw-bold text-decoration-none text-primary">
                                        @po.PoCode
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-medium">@po.Supplier?.Name</div>
                                    <small class="text-muted">@(po.Supplier?.Phone ?? "Chưa có SĐT")</small>
                                </td>
                                <td>@po.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (po.ExpectedDate.HasValue)
                                    {
                                        <span>@po.ExpectedDate.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    @po.TotalAmount.ToString("N0") đ
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-person me-1"></i>@(po.CreatedByNavigation?.FullName ?? "Admin")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @switch (po.Status)
                                    {
                                        case "Draft":
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Nháp</span>
                                            break;
                                        case "Sent":
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Đã gửi NCC</span>
                                            break;
                                        case "PartiallyFulfilled":
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Giao 1 phần</span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Hoàn thành</span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@po.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-id="@po.PoId" class="btn btn-sm btn-outline-primary rounded-2 px-2 py-1" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy đơn mua hàng nào phù hợp với điều kiện lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
