@using SWP391_G5.Models.Entities
@using SWP391_G5.Models.ViewModels
@model CreatePurchaseOrderViewModel
@{
    bool editing = ViewBag.EditId != null;
    ViewData["Title"] = editing ? "Sửa đơn mua hàng" : "Tạo đơn mua hàng";
    ViewData["PageTitle"] = ViewData["Title"];
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var ingredients = (IEnumerable<Ingredient>)ViewBag.Ingredients;
    var rows = Model.Items.Count > 0 ? Model.Items : new List<PurchaseOrderItemInputModel> { new() };
}
<a asp-action="Index" class="btn btn-outline-secondary mb-3">Danh sách PO</a>
<form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@ViewBag.EditId">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="card p-4 mb-3">
        <label asp-for="SupplierId">Nhà cung cấp *</label>
        <select asp-for="SupplierId" class="form-select mb-3" required><option value="">Chọn nhà cung cấp</option>@foreach (Supplier s in ViewBag.Suppliers) { <option value="@s.SupplierId">@s.Name</option> }</select>
        <label asp-for="OrderDate">Ngày đặt *</label><input asp-for="OrderDate" type="date" class="form-control mb-3" required />
        <label asp-for="ExpectedDate">Ngày dự kiến nhận *</label><input asp-for="ExpectedDate" type="date" class="form-control mb-3" required />
        <label asp-for="Note">Ghi chú</label><textarea asp-for="Note" maxlength="500" class="form-control"></textarea>
    </div>
    <div class="table-responsive"><table class="table table-bordered bg-white"><thead><tr><th>Nguyên liệu / ĐVT</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th><th></th></tr></thead><tbody id="itemsBody">
    @for (var i = 0; i < rows.Count; i++) {
        <tr><td><select name="Items[@i].IngredientId" class="form-select" required><option value="">Chọn nguyên liệu</option>@foreach (var ing in ingredients) { <option value="@ing.IngredientId" selected="@(ing.IngredientId == rows[i].IngredientId)">@ing.Name (@ing.Unit)</option> }</select></td>
        <td><input name="Items[@i].OrderedQty" value="@rows[i].OrderedQty.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.001" min="0.001" class="form-control qty" required /></td>
        <td><input name="Items[@i].UnitPrice" value="@rows[i].UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0" class="form-control price" required /></td>
        <td class="line-total"></td><td><button type="button" class="btn btn-outline-danger remove">Xóa</button></td></tr>
    }
    </tbody></table></div>
    <button type="button" id="addRow" class="btn btn-outline-primary">Thêm nguyên liệu</button>
    <p class="mt-3">Tổng tiền: <strong id="total"></strong></p>
    <button class="btn btn-primary" type="submit">Lưu bản nháp</button>
</form>
@section Scripts {
<script>
const body = document.getElementById('itemsBody');
function calculate() { let sum=0; [...body.rows].forEach((r,i)=> {r.querySelectorAll('[name]').forEach(e=>e.name=e.name.replace(/Items\[\d+\]/,`Items[${i}]`)); const cost=(+r.querySelector('.qty').value||0)*(+r.querySelector('.price').value||0); sum+=cost; r.querySelector('.line-total').textContent=cost.toLocaleString('vi-VN')+' đ';}); document.getElementById('total').textContent=sum.toLocaleString('vi-VN')+' đ'; }
const template = body.rows[0].cloneNode(true);
document.getElementById('addRow').onclick=()=>{const r=template.cloneNode(true); r.querySelector('select').value='';r.querySelectorAll('input').forEach(x=>x.value='');body.appendChild(r);calculate();};
body.addEventListener('click',e=>{if(e.target.closest('.remove') && body.rows.length>1){e.target.closest('tr').remove();calculate();}});body.addEventListener('input',calculate);calculate();
</script>
}
