@using SWP391_G5.Models.Entities
@using SWP391_G5.Models.ViewModels
@model CreatePurchaseOrderViewModel

@{
    ViewData["Title"] = "Lập đơn đặt hàng mới";
    ViewData["PageTitle"] = "Lập đơn đặt hàng Nhà cung cấp";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var suppliers = ViewBag.Suppliers as IEnumerable<Supplier> ?? Enumerable.Empty<Supplier>();
    var ingredients = ViewBag.Ingredients as IEnumerable<Ingredient> ?? Enumerable.Empty<Ingredient>();
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-2 d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách đơn
    </a>
</div>

<form method="post" asp-action="Create" id="createPoForm">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- Thông tin chung -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <span class="fw-bold">Thông tin đơn đặt hàng</span>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3">
                        <label asp-for="SupplierId" class="form-label small fw-semibold text-secondary">
                            Nhà cung cấp <span class="text-danger">*</span>
                        </label>
                        <select asp-for="SupplierId" class="form-select rounded-2" required>
                            <option value="">-- Chọn nhà cung cấp --</option>
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.SupplierId">@s.Name</option>
                            }
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExpectedDate" class="form-label small fw-semibold text-secondary">
                            Ngày dự kiến nhận hàng
                        </label>
                        <input asp-for="ExpectedDate" type="date" class="form-control rounded-2"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ExpectedDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Note" class="form-label small fw-semibold text-secondary">Ghi chú</label>
                        <textarea asp-for="Note" class="form-control rounded-2" rows="3"
                                  placeholder="Nhập ghi chú hoặc yêu cầu giao hàng..."></textarea>
                        <span asp-validation-for="Note" class="text-danger small"></span>
                    </div>

                    <div class="p-3 bg-light rounded-3 mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Tổng tiền dự kiến:</span>
                            <span class="fw-bold fs-5 text-danger" id="totalOrderAmount">0 đ</span>
                        </div>
                        <small class="text-muted" style="font-size: .75rem;">Đơn hàng sẽ được tạo với trạng thái ban đầu là <b>Bản nháp (Draft)</b>.</small>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-3 py-2 rounded-2 fw-medium">
                        <i class="bi bi-check2-circle me-1"></i> Xác nhận tạo đơn hàng
                    </button>
                </div>
            </div>
        </div>

        <!-- Chi tiết nguyên liệu -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <div>
                        <span class="fw-bold">Danh sách nguyên liệu đặt mua</span>
                        <small class="text-muted d-block" style="font-size:.75rem;">Chọn nguyên liệu và nhập số lượng, đơn giá</small>
                    </div>
                    <button type="button" id="btnAddRow" class="btn btn-sm btn-outline-primary rounded-2">
                        <i class="bi bi-plus-lg me-1"></i> Thêm nguyên liệu
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 small" id="itemsTable">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th class="ps-3" style="width: 45%;">Nguyên liệu</th>
                                    <th style="width: 25%;">Số lượng</th>
                                    <th style="width: 25%;">Đơn giá (VNĐ)</th>
                                    <th class="text-center pe-3" style="width: 5%;">Xoá</th>
                                </tr>
                            </thead>
                            <tbody id="itemsBody">
                                <!-- Dòng 1 mặc định -->
                                <tr class="item-row">
                                    <td class="ps-3">
                                        <select name="Items[0].IngredientId" class="form-select form-select-sm rounded-2 ing-select" required>
                                            <option value="">-- Chọn nguyên liệu --</option>
                                            @foreach (var ing in ingredients)
                                            {
                                                <option value="@ing.IngredientId">@ing.Name (@ing.Unit)</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="0.1" min="0.1" name="Items[0].OrderedQty"
                                               class="form-control form-control-sm rounded-2 qty-input" placeholder="SL" required />
                                    </td>
                                    <td>
                                        <input type="number" step="100" min="0" name="Items[0].UnitPrice"
                                               class="form-control form-control-sm rounded-2 price-input" placeholder="Đơn giá" required />
                                    </td>
                                    <td class="text-center pe-3">
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 btn-remove-row" title="Xoá dòng">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const itemsBody = document.getElementById("itemsBody");
            const btnAddRow = document.getElementById("btnAddRow");
            const totalDisplay = document.getElementById("totalOrderAmount");

            function updateTotal() {
                let sum = 0;
                document.querySelectorAll(".item-row").forEach(row => {
                    const qty = parseFloat(row.querySelector(".qty-input")?.value) || 0;
                    const price = parseFloat(row.querySelector(".price-input")?.value) || 0;
                    sum += (qty * price);
                });
                totalDisplay.textContent = new Intl.NumberFormat('vi-VN').format(sum) + " đ";
            }

            itemsBody.addEventListener("input", updateTotal);

            btnAddRow.addEventListener("click", function () {
                const index = itemsBody.querySelectorAll(".item-row").length;
                const firstRow = itemsBody.querySelector(".item-row");
                const newRow = firstRow.cloneNode(true);

                newRow.querySelector(".ing-select").name = `Items[${index}].IngredientId`;
                newRow.querySelector(".ing-select").selectedIndex = 0;

                const qtyInput = newRow.querySelector(".qty-input");
                qtyInput.name = `Items[${index}].OrderedQty`;
                qtyInput.value = "";

                const priceInput = newRow.querySelector(".price-input");
                priceInput.name = `Items[${index}].UnitPrice`;
                priceInput.value = "";

                itemsBody.appendChild(newRow);
            });

            itemsBody.addEventListener("click", function (e) {
                if (e.target.closest(".btn-remove-row")) {
                    const rows = itemsBody.querySelectorAll(".item-row");
                    if (rows.length > 1) {
                        e.target.closest(".item-row").remove();
                        // Đánh lại chỉ số name
                        itemsBody.querySelectorAll(".item-row").forEach((row, idx) => {
                            row.querySelector(".ing-select").name = `Items[${idx}].IngredientId`;
                            row.querySelector(".qty-input").name = `Items[${idx}].OrderedQty`;
                            row.querySelector(".price-input").name = `Items[${idx}].UnitPrice`;
                        });
                        updateTotal();
                    } else {
                        alert("Đơn hàng phải có ít nhất một nguyên liệu.");
                    }
                }
            });
        });
    </script>
}
