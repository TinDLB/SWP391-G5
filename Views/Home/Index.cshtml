@{
    ViewData["Title"] = "Trang chủ";
}

<div class="home-page">

    <!-- HERO SECTION -->
    <section class="hero-section">
        <div class="hero-overlay">
            <div class="hero-content">

                <span class="hero-badge">
                    BAKERY MANAGEMENT SYSTEM
                </span>

                <h1>
                    Bánh tươi mỗi ngày,<br />
                    dành cho những khoảnh khắc đặc biệt
                </h1>

                <p>
                    Khám phá các loại bánh ngọt, bánh sinh nhật,
                    mousse và combo được làm mới mỗi ngày.
                </p>

                <div class="hero-actions">

                    <a href="#products" class="btn-main">
                        Xem menu
                    </a>

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn-outline">
                            Đăng nhập
                        </a>
                    }

                </div>

            </div>
        </div>
    </section>


    <!-- SEARCH + FILTER -->
    <section class="search-section">

        <div class="search-box">

            <span class="search-icon">
                🔍
            </span>

            <input type="text"
                   placeholder="Tìm bánh, đồ uống..." />

            <select>
                <option value="">
                    Mặc định
                </option>

                <option value="price-asc">
                    Giá thấp → cao
                </option>

                <option value="price-desc">
                    Giá cao → thấp
                </option>

                <option value="newest">
                    Mới nhất
                </option>
            </select>

        </div>


        <!-- CATEGORY -->
        <div class="category-list">

            <button class="category active">
                Tất cả
            </button>

            <button class="category">
                Bánh sinh nhật
            </button>

            <button class="category">
                Bánh ngọt
            </button>

            <button class="category">
                Bánh mì
            </button>

            <button class="category">
                Bánh mousse
            </button>

            <button class="category">
                Sweetbox
            </button>

            <button class="category">
                Dessert
            </button>

            <button class="category">
                Cookie & Bánh nướng
            </button>

            <button class="category">
                Combo
            </button>

        </div>


        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="member-banner">
                ⚡
                <strong>
                    Đăng nhập thành viên
                </strong>
                để nhận ưu đãi và tích điểm mỗi đơn hàng
            </div>
        }
        else
        {
            <div class="member-banner">
                🎁
                <strong>
                    Thành viên BMS
                </strong>
                – mua bánh và tích điểm để nhận ưu đãi
            </div>
        }

    </section>



    <!-- FEATURED PRODUCTS -->
    <section id="products"
             class="product-section">

        <div class="section-header">

            <div>
                <span class="section-label">
                    SẢN PHẨM NỔI BẬT
                </span>

                <h2>
                    Bánh được yêu thích
                </h2>
            </div>

            <a href="#"
               class="view-all">
                Xem tất cả →
            </a>

        </div>


        <div class="product-grid">

            <!-- PRODUCT 1 -->
            <div class="product-card">

                <div class="product-image">

                    <span class="badge-featured">
                        Nổi bật
                    </span>

                    <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587"
                         alt="Chocolate Cake" />

                    <button class="cart-button">
                        🛒
                    </button>

                </div>

                <div class="product-info">

                    <span class="product-category">
                        BÁNH KEM
                    </span>

                    <h3>
                        Chocolate Dream Cake
                    </h3>

                    <p>
                        Bánh chocolate đậm vị,
                        phủ kem mềm mịn và thơm béo.
                    </p>

                    <div class="price">
                        520.000 đ
                    </div>

                </div>

            </div>


            <!-- PRODUCT 2 -->
            <div class="product-card">

                <div class="product-image">

                    <span class="badge-featured">
                        Nổi bật
                    </span>

                    <img src="https://images.unsplash.com/photo-1571115177098-24ec42ed204d"
                         alt="Mousse Cake" />

                    <button class="cart-button">
                        🛒
                    </button>

                </div>

                <div class="product-info">

                    <span class="product-category">
                        BÁNH MOUSSE
                    </span>

                    <h3>
                        Mango Mousse
                    </h3>

                    <p>
                        Mousse xoài thanh mát,
                        mềm nhẹ và vị trái cây tự nhiên.
                    </p>

                    <div class="price">
                        320.000 đ
                    </div>

                </div>

            </div>


            <!-- PRODUCT 3 -->
            <div class="product-card">

                <div class="product-image">

                    <img src="https://images.unsplash.com/photo-1486427944299-d1955d23e34d"
                         alt="Sweet Box" />

                    <button class="cart-button">
                        🛒
                    </button>

                </div>

                <div class="product-info">

                    <span class="product-category">
                        SWEETBOX
                    </span>

                    <h3>
                        Sweet Mini Box
                    </h3>

                    <p>
                        Set bánh mini nhiều hương vị,
                        phù hợp làm quà hoặc dùng trong tiệc.
                    </p>

                    <div class="price">
                        280.000 đ
                    </div>

                </div>

            </div>


            <!-- PRODUCT 4 -->
            <div class="product-card">

                <div class="product-image">

                    <img src="https://images.unsplash.com/photo-1464349095431-e9a21285b5f3"
                         alt="Birthday Cake" />

                    <button class="cart-button">
                        🛒
                    </button>

                </div>

                <div class="product-info">

                    <span class="product-category">
                        BÁNH SINH NHẬT
                    </span>

                    <h3>
                        Strawberry Birthday Cake
                    </h3>

                    <p>
                        Bánh kem dâu tươi,
                        phù hợp sinh nhật và các dịp đặc biệt.
                    </p>

                    <div class="price">
                        450.000 đ
                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- NEW PRODUCTS -->
    <section class="product-section second-section">

        <div class="section-header">

            <div>
                <span class="section-label">
                    MENU BÁNH
                </span>

                <h2>
                    Khám phá thêm
                </h2>
            </div>

            <a href="#"
               class="view-all">
                Xem tất cả →
            </a>

        </div>


        <div class="product-grid">

            <div class="product-card">

                <div class="product-image">

                    <img src="https://images.unsplash.com/photo-1559620192-032c4bc4674e"
                         alt="Cake" />

                    <button class="cart-button">
                        🛒
                    </button>

                </div>

                <div class="product-info">

                    <span class="product-category">
                        DESSERT
                    </span>

                    <h3>
                        Vanilla Cream Cake
                    </h3>

                    <p>
                        Bánh vanilla nhẹ nhàng,
                        phù hợp cho mọi dịp.
                    </p>

                    <div class="price">
                        390.000 đ
                    </div>

                </div>

            </div>


            <div class="product-card">

                <div class="product-image">

                    <img src="https://images.unsplash.com/photo-1542826438-bd32f43d626f"
                         alt="Cake" />

                    <button class="cart-button">
                        🛒
                    </button>

                </div>

                <div class="product-info">

                    <span class="product-category">
                        BÁNH NGỌT
                    </span>

                    <h3>
                        Cream Berry Cake
                    </h3>

                    <p>
                        Bánh kem kết hợp trái cây tươi,
                        vị ngọt vừa phải.
                    </p>

                    <div class="price">
                        410.000 đ
                    </div>

                </div>

            </div>


            <div class="product-card">

                <div class="product-image">

                    <img src="https://images.unsplash.com/photo-1519915028121-7d3463d20b13"
                         alt="Cake" />

                    <button class="cart-button">
                        🛒
                    </button>

                </div>

                <div class="product-info">

                    <span class="product-category">
                        COOKIE & BÁNH NƯỚNG
                    </span>

                    <h3>
                        Butter Cookie Box
                    </h3>

                    <p>
                        Cookie bơ thơm giòn,
                        đóng hộp tiện lợi.
                    </p>

                    <div class="price">
                        180.000 đ
                    </div>

                </div>

            </div>


            <div class="product-card">

                <div class="product-image">

                    <img src="https://images.unsplash.com/photo-1535141192574-5d4897c12636"
                         alt="Cake" />

                    <button class="cart-button">
                        🛒
                    </button>

                </div>

                <div class="product-info">

                    <span class="product-category">
                        COMBO
                    </span>

                    <h3>
                        Celebration Combo
                    </h3>

                    <p>
                        Combo bánh dành cho
                        tiệc sinh nhật và sự kiện nhỏ.
                    </p>

                    <div class="price">
                        699.000 đ
                    </div>

                </div>

            </div>

        </div>

    </section>



 <!-- BENEFITS -->
<section class="benefit-section">

    <div class="benefit-item">
        <div class="benefit-icon">🍰</div>

        <h4>Bánh tươi mỗi ngày</h4>

        <p>
            Sản xuất mới mỗi ngày
            để đảm bảo chất lượng.
        </p>
    </div>


    <div class="benefit-item">
        <div class="benefit-icon">🛵</div>

        <h4>Giao hàng tiện lợi</h4>

        <p>
            Giao hàng nhanh chóng
            và thuận tiện.
        </p>
    </div>


    <div class="benefit-item">
        <div class="benefit-icon">🎁</div>

        <h4>Tích điểm thành viên</h4>

        <p>
            Mua hàng và nhận điểm
            để đổi voucher.
        </p>
    </div>


    <div class="benefit-item">
        <div class="benefit-icon">💳</div>

        <h4>Thanh toán linh hoạt</h4>

        <p>
            Hỗ trợ COD, VNPay
            và nhiều phương thức khác.
        </p>
    </div>

</section>


<!-- LOCATION / MAP -->
<section class="location-section">

    <div class="location-container">

        <!-- LEFT INFO -->
        <div class="location-info">

            <span class="section-label">
                CỬA HÀNG
            </span>

            <h2>
                Ghé thăm Bakery BMS
            </h2>

            <p class="location-description">
                Hãy ghé cửa hàng để thưởng thức những chiếc bánh
                tươi mới được chuẩn bị mỗi ngày.
            </p>


            <div class="location-detail">

                <div class="location-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>

                <div>
                    <strong>Địa chỉ</strong>
                    <span>
                        FPT University, Hòa Lạc, Hà Nội
                    </span>
                </div>

            </div>


            <div class="location-detail">

                <div class="location-icon">
                    <i class="bi bi-telephone-fill"></i>
                </div>

                <div>
                    <strong>Điện thoại</strong>
                    <span>
                        0123 456 789
                    </span>
                </div>

            </div>


            <div class="location-detail">

                <div class="location-icon">
                    <i class="bi bi-clock-fill"></i>
                </div>

                <div>
                    <strong>Giờ mở cửa</strong>
                    <span>
                        08:00 - 22:00 mỗi ngày
                    </span>
                </div>

            </div>

        </div>


        <!-- RIGHT MAP -->
        <div class="map-box">

            <iframe
                src="https://www.google.com/maps?q=21.0124167,105.5252892&z=16&output=embed"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>

        </div>

    </div>

</section>