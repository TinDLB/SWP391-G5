@model SWP391_G5.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ - Bakery Management System";
}

<!-- ═════════════════════════════════════════════════════════════════════
     1. HERO BANNER CAROUSEL (Bakery Management System)
     ═════════════════════════════════════════════════════════════════════ -->
<section class="hero-banner-section mb-4">
    <div id="homeHeroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
        <!-- Indicators -->
        <div class="carousel-indicators custom-carousel-dots">
            <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
            <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="2"></button>
        </div>

        <div class="carousel-inner">
            <!-- Slide 1: Phong cách Bakery BMS cổ điển -->
            <div class="carousel-item active">
                <div class="hero-slide-content py-4 py-lg-5">
                    <div class="container">
                        <div class="row align-items-center g-3">
                            <!-- Bên trái: Bánh sinh nhật dâu tây socola nổi bật -->
                            <div class="col-md-4 text-center order-2 order-md-1">
                                <div class="hero-cake-frame left-cake">
                                    <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=600&auto=format&fit=crop&q=80" 
                                         alt="Bánh sinh nhật cao cấp" class="img-fluid hero-cake-img rounded-circle shadow-lg" />
                                </div>
                            </div>

                            <!-- Ở giữa: Slogan, Hotline, Logo cổ điển -->
                            <div class="col-md-4 text-center order-1 order-md-2">
                                <div class="hero-center-box px-2">
                                    <div class="hero-logo-emblem mb-3">
                                        <div class="emblem-circle mx-auto">
                                            <span class="emblem-txt">BMS</span>
                                            <span class="emblem-sub">Bakery</span>
                                        </div>
                                    </div>

                                    <h1 class="hero-french-slogan mb-3">
                                        Bakery Management<br />
                                        <span class="slogan-sub">Tươi mới mỗi ngày</span>
                                    </h1>

                                    <div class="hero-order-info d-flex align-items-center justify-content-center gap-3 flex-wrap">
                                        <div class="order-hotline">
                                            <i class="bi bi-telephone-fill text-warning me-1"></i> Đặt hàng ngay: 
                                            <strong class="text-dark">0987 654 321</strong>
                                        </div>
                                        <div class="order-web text-muted small d-none d-sm-block">
                                            <i class="bi bi-globe me-1"></i> www.bakerymanagementsystem.vn
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <a asp-controller="Product" asp-action="Index" class="btn btn-hero-order px-4 py-2 rounded-pill shadow-sm">
                                            <i class="bi bi-basket3-fill me-1"></i> KHÁM PHÁ THỰC ĐƠN
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Bên phải: Đĩa bánh ngọt Pastries / Tarts -->
                            <div class="col-md-4 text-center order-3">
                                <div class="hero-cake-frame right-cake">
                                    <img src="https://images.unsplash.com/photo-1509440159596-0249088772ff?w=600&auto=format&fit=crop&q=80" 
                                         alt="Bánh ngọt cao cấp" class="img-fluid hero-cake-img rounded-4 shadow-lg" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2: Bánh Sinh Nhật & Bánh Cưới Nghệ Thuật -->
            <div class="carousel-item">
                <div class="hero-slide-content py-4 py-lg-5" style="background: linear-gradient(135deg, #F5EFEB 0%, #EFE5DC 100%);">
                    <div class="container text-center">
                        <span class="badge bg-danger rounded-pill px-3 py-2 mb-2 text-uppercase letter-spacing-1">Bộ Sưu Tập Bánh Sinh Nhật 2026</span>
                        <h2 class="display-5 fw-bold text-dark mb-3" style="font-family: 'Playfair Display', serif;">Ngọt Ngào Từng Khoảnh Khắc</h2>
                        <p class="text-muted mx-auto mb-4" style="max-width: 650px;">
                            Hơn 100 mẫu bánh kem tươi, tiramisu, mousse hoa quả thiết kế theo yêu cầu riêng. Giao tận tay đúng giờ trong 2 giờ tại Hà Nội.
                        </p>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="btn btn-hero-order px-4 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-cake2-fill me-2"></i> XEM BỘ SƯU TẬP BÁNH KEM
                        </a>
                    </div>
                </div>
            </div>

            <!-- Slide 3: Bánh Mì & Cookies Nướng Mới -->
            <div class="carousel-item">
                <div class="hero-slide-content py-4 py-lg-5" style="background: linear-gradient(135deg, #F8F3EA 0%, #EDE1CE 100%);">
                    <div class="container text-center">
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2 mb-2 text-uppercase letter-spacing-1">Tươi Mới Mỗi Buổi Sáng</span>
                        <h2 class="display-5 fw-bold text-dark mb-3" style="font-family: 'Playfair Display', serif;">Bánh Mì & Cookies Thơm Ngon</h2>
                        <p class="text-muted mx-auto mb-4" style="max-width: 650px;">
                            Bánh mì bơ sữa, Baguette truyền thống và Cookies nướng mới mỗi sáng với 100% bơ lạt tự nhiên.
                        </p>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" class="btn btn-hero-order px-4 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-shop me-2"></i> ĐẶT BÁNH MÌ NGAY
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon rounded-circle bg-dark bg-opacity-25 p-3"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon rounded-circle bg-dark bg-opacity-25 p-3"></span>
        </button>
    </div>
</section>

<!-- ═════════════════════════════════════════════════════════════════════
     2. QUICK CATEGORY ICONS BAR (Dải danh mục nhanh)
     ═════════════════════════════════════════════════════════════════════ -->
<section class="container mb-5">
    <div class="row g-3 justify-content-center text-center">
        <div class="col-6 col-sm-3 col-lg-2">
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="quick-cat-card text-decoration-none d-block p-3 rounded-4 shadow-sm">
                <div class="cat-icon-circle mx-auto mb-2" style="background:#FFF0F0; color:#E53935;">
                    <i class="bi bi-cake2-fill fs-3"></i>
                </div>
                <div class="fw-bold text-dark small">Bánh Sinh Nhật</div>
                <small class="text-muted">Bánh kem tươi</small>
            </a>
        </div>
        <div class="col-6 col-sm-3 col-lg-2">
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" class="quick-cat-card text-decoration-none d-block p-3 rounded-4 shadow-sm">
                <div class="cat-icon-circle mx-auto mb-2" style="background:#FFF9E6; color:#D97706;">
                    <i class="bi bi-basket2-fill fs-3"></i>
                </div>
                <div class="fw-bold text-dark small">Bánh Mỳ & Mặn</div>
                <small class="text-muted">Bơ sữa, Baguette</small>
            </a>
        </div>
        <div class="col-6 col-sm-3 col-lg-2">
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="4" class="quick-cat-card text-decoration-none d-block p-3 rounded-4 shadow-sm">
                <div class="cat-icon-circle mx-auto mb-2" style="background:#F0FDF4; color:#16A34A;">
                    <i class="bi bi-cookie fs-3"></i>
                </div>
                <div class="fw-bold text-dark small">Cookies & Mini</div>
                <small class="text-muted">Giòn thơm béo ngậy</small>
            </a>
        </div>
        <div class="col-6 col-sm-3 col-lg-2">
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="3" class="quick-cat-card text-decoration-none d-block p-3 rounded-4 shadow-sm">
                <div class="cat-icon-circle mx-auto mb-2" style="background:#FDF2F8; color:#DB2777;">
                    <i class="bi bi-cup-hot-fill fs-3"></i>
                </div>
                <div class="fw-bold text-dark small">Pastry & Mousse</div>
                <small class="text-muted">Caramen, Tiramisu</small>
            </a>
        </div>
    </div>
</section>

<!-- ═════════════════════════════════════════════════════════════════════
     3. NEW CAKE COLLECTION (Bộ Sưu Tập Bánh Mới)
     ═════════════════════════════════════════════════════════════════════ -->
<section class="new-collection-section py-5 mb-5">
    <div class="container">
        <!-- Tiêu đề bộ sưu tập bánh -->
        <div class="text-center mb-4">
            <h2 class="collection-title mb-2">NEW CAKE COLLECTION</h2>
            <div class="collection-title-ornament">
                <i class="bi bi-cake2"></i>
            </div>
            

        </div>

        <!-- Lưới 8 Card sản phẩm (4 cột x 2 dòng) -->
        <div class="row g-4">
            @if (Model.NewCakeCollection != null && Model.NewCakeCollection.Any())
            {
                int counter = 1;
                @foreach (var p in Model.NewCakeCollection)
                {
                    string skuCode = p.ProductId switch {
                        1 => "KT101",
                        2 => "BM002",
                        3 => "CP015",
                        4 => "CK004",
                        5 => "KT111",
                        6 => "KT112",
                        7 => "CM031",
                        8 => "CM030",
                        9 => "MS021",
                        10 => "KT105",
                        _ => "SP0" + p.ProductId
                    };

                    string fallbackImg = (counter % 4) switch {
                        1 => "https://images.unsplash.com/photo-1535141192574-5d4897c13136?w=600&auto=format&fit=crop&q=80",
                        2 => "https://images.unsplash.com/photo-1588195538326-c5b1e9f80a1b?w=600&auto=format&fit=crop&q=80",
                        3 => "https://images.unsplash.com/photo-1563729784474-d77dbb933a9e?w=600&auto=format&fit=crop&q=80",
                        _ => "https://images.unsplash.com/photo-1565958011703-44f9829ba187?w=600&auto=format&fit=crop&q=80"
                    };
                    counter++;

                    string imgSrc = string.IsNullOrEmpty(p.ImageUrl) ? fallbackImg : p.ImageUrl;

                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="cake-product-card h-100 shadow-sm">
                            <!-- Ảnh bánh -->
                            <div class="cake-img-wrapper position-relative">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.ProductId">
                                    <img src="@imgSrc" alt="@p.Name" class="img-fluid cake-card-img" loading="lazy" />
                                </a>
                                @if (p.StockQty <= 0)
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2 rounded-pill">Hết hàng</span>
                                }
                            </div>

                            <!-- Đường răng cưa / separator -->
                            <div class="scallop-divider"></div>

                            <!-- Thân Card -->
                            <div class="cake-card-body p-3 text-center">
                                <!-- Hotline / Brand Header -->
                                <div class="card-brand-header d-flex align-items-center justify-content-center gap-2 mb-2">
                                    <div class="mini-logo-stamp">BMS</div>
                                    <span class="card-hotline-txt">Hotline: 0987 654 321</span>
                                </div>

                                <!-- Tên bánh viết hoa in đậm -->
                                <h6 class="cake-product-name mb-1">
                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.ProductId" class="text-decoration-none text-dark">
                                        @p.Name.ToUpper()
                                    </a>
                                </h6>

                                <!-- Mã SKU (KT111, KT112, CM031...) -->
                                <div class="cake-sku-code mb-3">@skuCode</div>

                                <!-- Thanh giá màu vàng + Nút Giỏ hàng -->
                                <div class="cake-price-cart-bar d-flex align-items-stretch">
                                    <div class="cake-price-lime-badge flex-grow-1 d-flex align-items-center justify-content-center">
                                        <span>@p.Price.ToString("N0")đ</span>
                                    </div>
                                    <button type="button" class="btn cake-cart-brown-btn" onclick="addToCart(@p.ProductId, 1)" title="Thêm vào giỏ hàng">
                                        <i class="bi bi-cart-fill"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Nút xem thêm -->
        <div class="text-center mt-5">
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark rounded-pill px-5 py-2 fw-semibold">
                XEM TẤT CẢ SẢN PHẨM <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

