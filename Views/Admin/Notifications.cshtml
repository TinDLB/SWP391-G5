@model IEnumerable<SWP391_G5.Models.Entities.Notification>
@{
    ViewData["Title"] = "Thông báo"; ViewData["PageTitle"] = "Thông báo hệ thống"; Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-3"><h5 class="mb-0">Thông báo gần đây</h5><a asp-action="Notifications" asp-route-unreadOnly="true" class="btn btn-sm btn-outline-secondary">Chưa đọc</a></div>
<div class="card border-0 shadow-sm">
    <div class="list-group list-group-flush">
        @if (!Model.Any())
        {
            <div class="p-4 text-center text-muted">Chưa có thông báo.</div>
        }
        @foreach (var notification in Model)
        {
            <div class="list-group-item d-flex justify-content-between align-items-start @(notification.IsRead ? "" : "bg-light")"><div><div class="fw-semibold">@notification.Title</div><div class="small text-muted">@notification.Message</div><div class="small text-secondary">@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div></div>@if (!notification.IsRead) {
            <form asp-action="MarkNotificationRead" method="post"><input type="hidden" name="id" value="@notification.NotificationId" /><button class="btn btn-sm btn-outline-primary">Đã đọc</button></form>
        }
</div>
                }
    </div>
</div>
