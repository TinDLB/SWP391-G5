@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Tổng quan hệ thống";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row g-4 mb-4">
    <div class="col-12">
        <h5 class="fw-semibold text-muted mb-0">
            Xin chào, <span class="text-dark">@User.Identity!.Name</span> 👋
        </h5>
        <p class="text-muted small mt-1">Đây là tổng quan hoạt động của hệ thống hôm nay.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width:52px;height:52px;background:rgba(232,98,26,.12);flex-shrink:0;">
                    <i class="bi bi-basket3-fill fs-4" style="color:#e8621a;"></i>
                </div>
                <div>
                    <div class="text-muted small">Tổng sản phẩm</div>
                    <div class="fw-bold fs-4 lh-1 mt-1">—</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width:52px;height:52px;background:rgba(25,135,84,.12);flex-shrink:0;">
                    <i class="bi bi-receipt fs-4 text-success"></i>
                </div>
                <div>
                    <div class="text-muted small">Đơn hàng hôm nay</div>
                    <div class="fw-bold fs-4 lh-1 mt-1">—</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width:52px;height:52px;background:rgba(13,110,253,.12);flex-shrink:0;">
                    <i class="bi bi-people-fill fs-4 text-primary"></i>
                </div>
                <div>
                    <div class="text-muted small">Người dùng</div>
                    <div class="fw-bold fs-4 lh-1 mt-1">—</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width:52px;height:52px;background:rgba(220,53,69,.12);flex-shrink:0;">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                </div>
                <div>
                    <div class="text-muted small">Nguyên liệu sắp hết</div>
                    <div class="fw-bold fs-4 lh-1 mt-1">—</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4 text-center text-muted py-5">
        <i class="bi bi-bar-chart-line display-4 d-block mb-3 text-secondary opacity-50"></i>
        <p class="mb-2">Dashboard đang được phát triển.</p>
        <a asp-controller="Admin" asp-action="Products" class="btn btn-sm btn-outline-secondary rounded-pill">
            <i class="bi bi-basket3 me-1"></i> Đến Quản lý bánh
        </a>
    </div>
</div>
