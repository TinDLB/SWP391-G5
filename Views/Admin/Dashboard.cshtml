@model SWP391_G5.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan hệ thống";
    ViewData["PageTitle"] = "Tổng quan hệ thống";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Tổng quan cửa hàng</h4>
        <p class="text-muted mb-0">Theo dõi hoạt động bán bánh và tình trạng kho.</p>
    </div>
    <form method="get" asp-action="Dashboard" class="d-flex flex-wrap gap-2">
        <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control"
               aria-label="Từ ngày"/>
        <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control"
               aria-label="Đến ngày"/>
        <button class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Lọc</button>
        <button type="submit" formaction="@Url.Action("ExportReport", "Admin")" class="btn btn-outline-success">
            <i class="bi bi-download me-1"></i>CSV
        </button>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-stat h-100">
            <div class="card-body">
                <i class="bi bi-cupcake-fill stat-icon text-warning"></i>
                <div class="text-muted small">Sản phẩm đang bán</div>
                <div class="fs-3 fw-bold">@Model.ProductCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-stat h-100">
            <div class="card-body">
                <i class="bi bi-receipt-cutoff stat-icon text-primary"></i>
                <div class="text-muted small">Đơn hàng hôm nay</div>
                <div class="fs-3 fw-bold">@Model.TodayOrderCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-stat h-100">
            <div class="card-body">
                <i class="bi bi-cash-coin stat-icon text-success"></i>
                <div class="text-muted small">Doanh thu hôm nay</div>
                <div class="fs-3 fw-bold text-success">@Model.TodayRevenue.ToString("N0") ₫</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-stat h-100">
            <div class="card-body">
                <i class="bi bi-exclamation-triangle-fill stat-icon text-danger"></i>
                <div class="text-muted small">Nguyên liệu sắp hết</div>
                <div class="fs-3 fw-bold">@Model.LowStockCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card dashboard-report border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div><h5 class="fw-bold mb-1">Báo cáo bán hàng</h5><span
                    class="text-muted small">@Model.From.ToString("dd/MM/yyyy") - @Model.To.ToString("dd/MM/yyyy")</span>
            </div>
            <i class="bi bi-bar-chart-line fs-3 text-warning"></i>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="report-item">
                    <span>Tổng đơn hàng</span>
                    <strong>@Model.ReportOrderCount</strong>
                </div>
            </div>
            <div class="col-md-4">
                <div class="report-item">
                    <span>Đơn hoàn tất</span>
                    <strong class="text-success">@Model.CompletedOrderCount</strong>
                </div>
            </div>
            <div class="col-md-4">
                <div class="report-item">
                    <span>Đơn đã hủy</span>
                    <strong class="text-danger">@Model.CancelledOrderCount</strong>
                </div>
            </div>
            <div class="col-md-6">
                <div class="report-item">
                    <span>Doanh thu đã thanh toán</span>
                    <strong class="text-primary">@Model.ReportRevenue.ToString("N0") ₫</strong>
                </div>
            </div>
            <div class="col-md-6">
                <div class="report-item">
                    <span>Người dùng mới</span>
                    <strong>@Model.NewUserCount</strong>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.LowStockItems.Count > 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-bold"><i class="bi bi-box-seam me-2 text-warning"></i>Nguyên liệu cần
            nhập thêm
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr>
                    <th>Nguyên liệu</th>
                    <th>Tồn kho</th>
                    <th>Ngưỡng tối thiểu</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.LowStockItems.Take(5))
                {
                    <tr>
                        <td>@item.Name</td>
                        <td class="text-danger fw-semibold">@item.StockQty.ToString("#,##0.###") @item.Unit</td>
                        <td>@item.MinThreshold.ToString("#,##0.###") @item.Unit</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
    .dashboard-stat, .dashboard-report {
        border: 0;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(90, 54, 29, .08);
    }

    .dashboard-stat .card-body {
        position: relative;
        padding: 1.25rem;
    }

    .stat-icon {
        position: absolute;
        right: 1.25rem;
        top: 1.25rem;
        font-size: 1.5rem;
        opacity: .8;
    }

    .report-item {
        background: #fffaf4;
        border: 1px solid #f1dfca;
        border-radius: 10px;
        padding: .85rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .report-item span {
        color: #6b625b;
    }

    .report-item strong {
        font-size: 1.2rem;
    }
</style>
