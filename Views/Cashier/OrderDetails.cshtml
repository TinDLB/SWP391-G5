@model SWP391_G5.Models.ViewModels.CashierOrderDetailsViewModel
@{
    Layout = "_CashierLayout"; ViewData["Title"] = "Chi tiết đơn hàng";
}
<div class="d-flex justify-content-between align-items-center mb-3"><h4 class="fw-bold">Đơn hàng @Model.OrderCode</h4><a asp-action="Orders" class="btn btn-outline-secondary">Quay lại</a></div>
<div class="row g-3"><div class="col-lg-8">
 <div class="card stat-card mb-3"><div class="card-body"><div class="row"><div class="col-md-6"><p><strong>Kênh:</strong> @Model.Channel</p><p><strong>Trạng thái:</strong> @Model.Status</p><p><strong>Khách hàng:</strong> @Model.CustomerName</p></div><div class="col-md-6"><p><strong>Phương thức thanh toán:</strong> @(Model.PaymentMethod == "COD" ? "Tiền mặt khi nhận hàng" : Model.PaymentMethod)</p><p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p><p><strong>Địa chỉ:</strong> @(Model.DeliveryAddress ?? "Không có")</p></div></div>
 @if (!string.IsNullOrWhiteSpace(Model.DeliveryStaffName) || !string.IsNullOrWhiteSpace(Model.DeliveryStaffPhone)) { <div class="border-top mt-2 pt-2"><strong><i class="bi bi-person-badge me-1"></i>Người giao hàng:</strong> @(Model.DeliveryStaffName ?? "Chưa cập nhật") @if (!string.IsNullOrWhiteSpace(Model.DeliveryStaffPhone)) { <span class="ms-3"><strong>SĐT:</strong> <a href="tel:@Model.DeliveryStaffPhone">@Model.DeliveryStaffPhone</a></span> }</div> }
 </div></div>
<div class="card stat-card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach (var item in Model.Items){<tr><td>@item.ProductName</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("N0") đ</td><td>@item.Amount.ToString("N0") đ</td></tr>}</tbody></table></div><div class="card-body text-end"><div>Tạm tính: @Model.Subtotal.ToString("N0") đ</div><div>Giảm giá: @Model.DiscountAmount.ToString("N0") đ</div><strong>Tổng: @Model.TotalAmount.ToString("N0") đ</strong></div></div>
</div><div class="col-lg-4"><div class="card stat-card"><div class="card-body"><h5>Thao tác</h5>
@if (Model.Status == "Pending" || Model.Status == "Preparing" || Model.Status == "Delivering") { <form asp-action="UpdateOrderStatus" method="post" class="mb-2"><input type="hidden" name="id" value="@Model.OrderId" /><input type="hidden" name="status" value="@(Model.Status == "Pending" ? "Preparing" : Model.Status == "Preparing" ? (Model.Channel == "Online" ? "Delivering" : "Completed") : "Completed")" /><button class="btn btn-primary w-100">@(Model.Status == "Pending" ? "Xác nhận và chuẩn bị" : Model.Status == "Preparing" ? (Model.Channel == "Online" ? "Bàn giao giao hàng" : "Hoàn tất đơn") : "Xác nhận đã giao")</button></form><form asp-action="UpdateOrderStatus" method="post" class="mb-2"><input type="hidden" name="id" value="@Model.OrderId" /><input type="hidden" name="status" value="Cancelled" /><button class="btn btn-outline-danger w-100" onclick="return confirm('Hủy đơn hàng này?')">Hủy đơn</button></form> }
@if (Model.Status == "Delivering" && Model.Channel == "Online") { <a asp-action="AssignDelivery" asp-route-id="@Model.OrderId" class="btn btn-outline-primary w-100 mb-2">Phân công giao hàng</a> }
 @if (Model.InvoiceNo == null && Model.Status != "Cancelled") { <form asp-action="GenerateInvoice" method="post"><input type="hidden" name="id" value="@Model.OrderId" /><button class="btn btn-outline-success w-100">Lập hóa đơn</button></form> }
 @if (Model.InvoiceNo != null) { <a asp-action="Invoice" asp-route-id="@Model.OrderId" class="btn btn-outline-success w-100 mt-2">Xem hóa đơn @Model.InvoiceNo</a><a asp-action="DownloadInvoice" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary w-100 mt-2">Tải hóa đơn</a> }
</div></div></div></div>
