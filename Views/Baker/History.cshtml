@model SWP391_G5.Models.ViewModels.BakerProductionHistoryListViewModel
@{
    ViewData["Title"] = "Lịch sử sản xuất";
    Layout = "~/Views/Shared/_BakerLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-clock-history text-primary me-2"></i>Lịch sử sản xuất
        </h4>
        <p class="text-muted small mb-0">Theo dõi các mẻ bánh đã hoàn tất, đối chiếu sản lượng thực tế và tỷ lệ đạt chuẩn.</p>
    </div>
</div>

<!-- Thống kê tổng quan -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card border-0 bg-white shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Tổng mẻ bánh</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalTasks</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 px-3 fs-4">
                        <i class="bi bi-cake2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card border-0 bg-white shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Thành phẩm đạt</div>
                        <div class="fs-4 fw-bold text-success">@Model.TotalSuccessQty.ToString("N0") <small class="fs-6 text-muted">cái</small></div>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 px-3 fs-4">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card border-0 bg-white shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Sản phẩm lỗi</div>
                        <div class="fs-4 fw-bold text-danger">@Model.TotalDefectQty.ToString("N0") <small class="fs-6 text-muted">cái</small></div>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-2 px-3 fs-4">
                        <i class="bi bi-exclamation-octagon"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card border-0 bg-white shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Tỷ lệ đạt chuẩn</div>
                        <div class="fs-4 fw-bold @(Model.OverallRate >= 90 ? "text-success" : Model.OverallRate >= 75 ? "text-warning" : "text-danger")">
                            @Model.OverallRate%
                        </div>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2 px-3 fs-4">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm & ngày tháng -->
<div class="card stat-card mb-4 border-0 shadow-sm bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="History" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Tìm kiếm</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" class="form-control border-start-0" placeholder="Tên bánh hoặc #Task ID..." value="@Model.Keyword" />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">Từ ngày</label>
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">Đến ngày</label>
                <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Keyword) || Model.FromDate.HasValue || Model.ToDate.HasValue)
                {
                    <a asp-action="History" class="btn btn-outline-secondary btn-sm" title="Xóa bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Danh sách mẻ bánh đã hoàn tất -->
@if (Model.Items == null || !Model.Items.Any())
{
    <div class="alert alert-info rounded-3 text-center py-4 bg-white border shadow-sm">
        <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
        Không có lịch sử sản xuất nào phù hợp với bộ lọc hiện tại.
    </div>
}
else
{
    <div class="card stat-card border-0 shadow-sm bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Mã Task</th>
                        <th>Sản phẩm</th>
                        <th class="text-center" style="width: 100px;">Mục tiêu</th>
                        <th class="text-center" style="width: 140px;">Đạt / Hỏng</th>
                        <th class="text-center" style="width: 120px;">Hiệu suất</th>
                        <th style="width: 160px;">Thời gian hoàn tất</th>
                        <th>Ghi chú</th>
                        <th class="text-center" style="width: 100px;">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var rateBadge = item.YieldRate >= 95 ? "bg-success" :
                                        item.YieldRate >= 80 ? "bg-primary" :
                                        item.YieldRate >= 60 ? "bg-warning text-dark" : "bg-danger";

                        <tr>
                            <td class="text-muted fw-semibold">#@item.TaskId</td>
                            <td>
                                <a asp-action="TaskDetail" asp-route-id="@item.TaskId" class="fw-bold text-decoration-none text-dark">
                                    @item.ProductName
                                </a>
                            </td>
                            <td class="text-center fw-semibold text-secondary">
                                @item.TargetQty.ToString("N0") cái
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success bg-opacity-75">
                                    <i class="bi bi-check-lg me-1"></i>@item.SuccessQty
                                </span>
                                @if (item.DefectQty > 0)
                                {
                                    <span class="badge bg-danger ms-1" title="Số lượng hỏng/lỗi">
                                        <i class="bi bi-x-lg me-1"></i>@item.DefectQty
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @rateBadge">@item.YieldRate%</span>
                            </td>
                            <td>
                                <div class="small fw-semibold">
                                    @(item.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                </div>
                                <div class="small text-muted">
                                    <i class="bi bi-stopwatch me-1"></i>Làm trong: @item.DurationText
                                </div>
                            </td>
                            <td class="small text-muted">
                                @(string.IsNullOrWhiteSpace(item.Note) ? "-" : item.Note)
                            </td>
                            <td class="text-center">
                                <a asp-action="TaskDetail" asp-route-id="@item.TaskId" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
