@using SWP391_G5.Models.ViewModels
@model RecipeEditViewModel
@{ ViewData["Title"] = "Chỉnh sửa công thức"; ViewData["PageTitle"] = "Chỉnh sửa công thức"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<h4 class="mb-3">Chỉnh sửa công thức</h4><form asp-action="Edit" asp-route-id="@Model.RecipeId" method="post">@Html.AntiForgeryToken()<input asp-for="RecipeId" type="hidden" /><partial name="_Form" model="Model" /><div class="mt-3"><button class="btn btn-primary">Lưu thay đổi</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div></form>
@section Scripts {
    <script>
        const options = `@Html.Raw(string.Join("", ((IEnumerable<SWP391_G5.Models.Entities.Ingredient>)ViewBag.Ingredients).Select(i => $"<option value='{i.IngredientId}'>{i.Name} ({i.Unit})</option>")))`;

        function addIngredient() {
            const index = `new_${Date.now()}`;
            document.querySelector('#ingredients tbody').insertAdjacentHTML('beforeend',
                `<tr>
                    <td><input type="hidden" name="Ingredients.index" value="${index}" /><select name="Ingredients[${index}].IngredientId" class="form-select" required onchange="preventDuplicateIngredient(this)"><option value="">-- Chọn --</option>${options}</select></td>
                    <td><input name="Ingredients[${index}].Quantity" type="number" min="0.001" step="0.001" class="form-control" required /></td>
                    <td><button type="button" class="btn btn-outline-danger" onclick="this.closest('tr').remove()">Xóa</button></td>
                </tr>`);
        }

        function preventDuplicateIngredient(select) {
            if (!select.value) return;

            const duplicate = [...document.querySelectorAll('#ingredients tbody select')]
                .some(other => other !== select && other.value === select.value);

            if (duplicate) {
                select.value = '';
                alert('Nguyên liệu này đã được chọn. Vui lòng chọn nguyên liệu khác.');
            }
        }
    </script>
}
