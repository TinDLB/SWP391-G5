@using SWP391_G5.Models.Entities
@using SWP391_G5.Models.ViewModels
@model CreateProductionTaskViewModel
@{
    ViewData["Title"] = "Tạo công việc sản xuất"; ViewData["PageTitle"] = "Tạo công việc sản xuất"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; 
    var products = ViewBag.Products as IEnumerable<Product> ?? Enumerable.Empty<Product>(); 
    var bakers = ViewBag.Bakers as IEnumerable<User> ?? Enumerable.Empty<User>();
}
<h4 class="mb-3">Tạo công việc sản xuất</h4>
<form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="card border-0 shadow-sm"><div class="card-body"><div class="row g-3"><div class="col-md-6"><label asp-for="ProductId" class="form-label">Sản phẩm</label><select asp-for="ProductId" class="form-select"><option value="">-- Chọn sản phẩm có công thức --</option>
@foreach(var p in products){
<option value="@p.ProductId">@p.Name</option>
                        }
                    </select><span asp-validation-for="ProductId" class="text-danger"></span>
                </div><div class="col-md-6"><label asp-for="TargetQty" class="form-label">Số lượng cần sản xuất</label><input asp-for="TargetQty" class="form-control" min="1" /><span asp-validation-for="TargetQty" class="text-danger"></span></div><div class="col-md-6">
                    <label asp-for="AssignedBaker" class="form-label">Baker phụ trách</label><select asp-for="AssignedBaker" class="form-select">
                        <option value="">-- Chọn Baker --</option>
                        @foreach (var baker in bakers)
                        {
                            <option value="@baker.UserId">@baker.FullName</option>
                        }
                    </select><span asp-validation-for="AssignedBaker" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Deadline" class="form-label">Deadline</label>
                    <input name="Deadline" id="Deadline" type="datetime-local" value="@(Model.Deadline?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
                    <span asp-validation-for="Deadline" class="text-danger"></span>
                <div class="col-12"><label asp-for="Note" class="form-label">Ghi chú</label><textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú cho Baker..."></textarea><span asp-validation-for="Note" class="text-danger"></span></div>
                <div class="col-12">
                    <div id="ingredientRequirements" class="d-none mt-2">
                        <h6 class="mb-2">So sánh nguyên liệu cần dùng và tồn kho</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-light"><tr><th>Nguyên liệu</th><th>Đơn vị</th><th>Sẽ dùng</th><th>Tồn kho</th><th>Thiếu</th><th>Trạng thái</th></tr></thead>
                                <tbody id="ingredientRequirementsBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-primary">Tạo và giao task</button> 
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>
@section Scripts {
    <script>
        const requirementUrl = '@Url.Action("IngredientRequirements", "ProductionTask")';
        const productSelect = document.getElementById('ProductId');
        const quantityInput = document.getElementById('TargetQty');
        const requirementsBox = document.getElementById('ingredientRequirements');
        const requirementsBody = document.getElementById('ingredientRequirementsBody');
        const formatQuantity = value => Number(value).toLocaleString('en-US', { useGrouping: false, maximumFractionDigits: 3 });

        async function loadIngredientRequirements() {
            const productId = productSelect.value;
            const targetQty = Number(quantityInput.value);

            if (!productId || targetQty <= 0) {
                requirementsBox.classList.add('d-none');
                requirementsBody.innerHTML = '';
                return;
            }

            const response = await fetch(`${requirementUrl}?productId=${productId}&targetQty=${targetQty}`);
            const items = await response.json();

            requirementsBody.innerHTML = items.length === 0
                ? '<tr><td colspan="6" class="text-center text-muted">Sản phẩm chưa có công thức hoạt động.</td></tr>'
                : items.map(item => `
                    <tr>
                        <td>${item.ingredientName}</td>
                        <td>${item.unit}</td>
                        <td>${formatQuantity(item.availableQty)}</td>
                        <td>${formatQuantity(item.stockQty)}</td>
                        <td class="${item.shortageQty > 0 ? 'text-danger fw-semibold' : 'text-success'}">${formatQuantity(item.shortageQty)}</td>
                        <td><span class="badge ${item.isEnough ? 'bg-success' : 'bg-danger'}">${item.isEnough ? '\u0110\u1ee7' : 'Thi\u1ebfu'}</span></td>
                    </tr>`).join('');

            requirementsBox.classList.remove('d-none');
        }

        productSelect.addEventListener('change', loadIngredientRequirements);
        quantityInput.addEventListener('input', loadIngredientRequirements);
    </script>
}
